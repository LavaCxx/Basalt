---
import type { CurrentItem, ManualGame, SteamStatus, SteamGame } from '../../lib/types';
import { getCurrentGames, getCurrentItems, getSteamSnapshot, initRuntime } from '../../lib/api';
import { mockCurrentItems } from '../../lib/mock-data';
import { mediaTypeLabels } from '../../lib/media-config';
import SmartImage from '../islands/SmartImage';

interface Props {
  currentItems?: CurrentItem[];
  stats?: { articles?: number; photos?: number; microblogs?: number; media?: number };
  steamGames?: SteamGame[];
  steamSnapshot?: SteamSnapshot;
  currentGames?: ManualGame[];
}

// Inject Cloudflare runtime env if available
const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) {
  initRuntime(runtimeEnv);
}

// Fetch current items - with fallback to mock data on error
let currentItems: CurrentItem[] = mockCurrentItems;
try {
  const fetched = await getCurrentItems();
  if (fetched.length > 0) {
    currentItems = fetched;
  }
} catch (e) {
  console.error('Failed to fetch current items:', e);
}

currentItems = Astro.props.currentItems || currentItems;
let steamGames: SteamGame[] = Astro.props.steamGames || [];
let steamStatus: SteamStatus = { online: false };
if (Astro.props.steamSnapshot) {
  steamGames = Astro.props.steamSnapshot.games;
  steamStatus = Astro.props.steamSnapshot.status;
} else {
  const snapshot = await getSteamSnapshot();
  steamGames = snapshot.games;
  steamStatus = snapshot.status;
}
const orderedSteamGames = [...steamGames].sort((game, otherGame) =>
  isCurrentSteamGame(game, steamStatus) ? -1 : isCurrentSteamGame(otherGame, steamStatus) ? 1 : 0
);
const currentGames = Astro.props.currentGames || await getCurrentGames();
const steamGameNames = new Set(steamGames.map((game) => game.name.trim().toLowerCase()));
const manualGames = currentGames.filter((game) => !steamGameNames.has(game.title.trim().toLowerCase()));
const stats = Astro.props.stats || {};

const typeLabels: Record<string, string> = {
  reading: '阅读中',
  watching: '观看中',
  playing: '游玩中',
  listening: '收听中',
};

function formatDate(date: Date): string {
  return date.getFullYear() === new Date().getFullYear()
    ? date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })
    : date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
}

function formatHours(minutes: number): string {
  return minutes >= 60 ? `${Math.round(minutes / 60)} 小时` : `${minutes} 分钟`;
}

function isCurrentSteamGame(game: SteamGame, status: SteamStatus): boolean {
  return status.currentGameId === game.id || Boolean(
    status.currentGameName && game.name === status.currentGameName
  );
}

function formatDaysInProgress(date?: Date): string {
  if (!date) return '';
  const days = Math.max(1, Math.ceil((Date.now() - date.getTime()) / 86400000));
  return `已进行 ${days} 天`;
}

---

<aside class="space-y-6">
 <!-- Recent non-game media -->
{currentItems.length > 0 && (
   <section class="border-t border-border pt-5 mt-5">
      <h3 class="text-sm font-medium text-text-secondary uppercase tracking-wider mb-3">
        最近
      </h3>
      <div class="space-y-3">
        {currentItems.map((item) => {
          const mediaType = (item as any).mediaType || (item.type === 'reading' ? 'book' : item.type === 'watching' ? 'movie' : item.type === 'listening' ? 'music' : 'game');
          return (
          <div class="flex items-start gap-3">
            {item.cover ? (
              <SmartImage
                src={item.cover}
                alt={item.title}
                class="rounded flex-shrink-0 w-10 h-14"
                client:visible
              />
            ) : (
              <div class="w-10 h-14 rounded bg-surface-secondary flex items-center justify-center flex-shrink-0">
                <span class="text-xs text-text-muted">
                  {mediaType === 'book' ? '书' : mediaType === 'movie' ? '影' : mediaType === 'tv' ? '剧' : mediaType === 'music' ? '音' : mediaType === 'game' ? '游' : mediaType === 'manga' ? '漫' : mediaType === 'anime' ? '番' : '看'}
                </span>
              </div>
            )}
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="media-badge" data-media={mediaType} style="padding: 0.125rem 0.375rem; font-size: 0.6875rem;">
                  {mediaTypeLabels[mediaType as keyof typeof mediaTypeLabels] || mediaType}
                </span>
                {item.date && (
                  <span class="text-xs text-text-muted">
                    {item.endDate
                      ? `${formatDate(item.date)} → ${formatDate(item.endDate)}`
                      : `已进行 ${Math.floor((Date.now() - (item.date as Date).getTime()) / 86400000)} 天`}
                  </span>
                )}
              </div>
              {item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-text-primary hover:underline transition-colors line-clamp-1"
                >
                  {item.title}
                </a>
              ) : (
                <p class="text-sm text-text-primary line-clamp-1">{item.title}</p>
              )}
              {item.author && (
                <p class="text-xs text-text-muted truncate">{item.author}</p>
              )}
              
            </div>
          </div>
        )})}
      </div>
    </section>
  )}
{(steamGames.length > 0 || manualGames.length > 0) && (
  <section class="border-t border-border pt-5 mt-5">
    <h3 class="text-sm font-medium text-text-secondary uppercase tracking-wider mb-3">
      游戏
    </h3>
    <div class="space-y-3">
      {orderedSteamGames.map((game) => (
        <a
          href={game.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3"
        >
          <SmartImage
            src={game.cover}
            alt={game.name}
            class="rounded-sm flex-shrink-0 w-16 h-9"
            client:visible
          />
          <div class="min-w-0 flex-1">
            <div class="flex min-w-0 items-center gap-2">
              <p class={`text-sm line-clamp-1 group-hover:underline ${isCurrentSteamGame(game, steamStatus) ? 'text-[#6cc644]' : 'text-text-primary'}`}>
                {game.name}
              </p>
              {isCurrentSteamGame(game, steamStatus) && (
                <span class="flex-shrink-0 text-xs text-[#6cc644]">正在玩</span>
              )}
            </div>
            <p class="text-xs text-text-muted truncate">
              两周 {formatHours(game.playtimeTwoWeeksMinutes)} · 总计 {formatHours(game.playtimeForeverMinutes)}
            </p>
          </div>
        </a>
      ))}
      {manualGames.map((game) => (
        <a
          href={game.url || '#'}
          target={game.url ? '_blank' : undefined}
          rel="noopener noreferrer"
          class="group flex items-center gap-3"
        >
          {game.cover ? (
            <SmartImage
              src={game.cover}
              alt={game.title}
              class="rounded-sm flex-shrink-0 w-16 h-9 object-cover"
              client:visible
            />
          ) : (
            <div class="w-16 h-9 rounded-sm bg-surface-secondary flex items-center justify-center flex-shrink-0">
              <span class="text-xs text-text-muted">游</span>
            </div>
          )}
          <div class="min-w-0 flex-1">
            <p class="text-sm text-text-primary line-clamp-1 group-hover:underline">{game.title}</p>
            <p class="text-xs text-text-muted truncate">
              {['手动记录', formatDaysInProgress(game.date)].filter(Boolean).join(' · ')}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
 <!-- Stats -->
 <section class="border-t border-border pt-5 mt-5">
   <h3 class="text-sm font-medium text-text-secondary uppercase tracking-wider mb-3">
     统计
    </h3>
    <div class="grid grid-cols-2 gap-4 text-center">
      {stats.articles !== undefined && (
        <div>
          <p class="text-2xl font-ui font-semibold text-text-primary">{stats.articles}</p>
          <p class="text-xs text-text-muted">篇文章</p>
        </div>
      )}
      {stats.photos !== undefined && (
        <div>
          <p class="text-2xl font-ui font-semibold text-text-primary">{stats.photos}</p>
          <p class="text-xs text-text-muted">张照片</p>
        </div>
      )}
      {stats.microblogs !== undefined && (
        <div>
          <p class="text-2xl font-ui font-semibold text-text-primary">{stats.microblogs}</p>
          <p class="text-xs text-text-muted">条动态</p>
        </div>
      )}
      {stats.media !== undefined && (
        <div>
          <p class="text-2xl font-ui font-semibold text-text-primary">{stats.media}</p>
          <p class="text-xs text-text-muted">条标记</p>
        </div>
      )}
    </div>
  </section>

  <!-- Social Links -->
  <section class="border-t border-border pt-5 mt-5">
    <div class="flex items-center gap-4">
      <a href="https://github.com/LavaCxx" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="GitHub">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <a href="https://steamcommunity.com/id/ArcRains/" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="Steam" title="Steam">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><circle cx="10" cy="10" r="2.5" /><path d="M17.5 16.5 13 13" /><circle cx="17" cy="17" r="1.5" /></svg>
      </a>
      <a href="/rss.xml" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="RSS">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
      </a>
      <a href="mailto:lavac@foxmail.com" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="Email">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </a>
      <a href="/drive" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="Voxel Drive" title="Voxel Drive">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M3 13l1.5-4.5A2 2 0 0 1 6.4 7h11.2a2 2 0 0 1 1.9 1.5L21 13v5h-2a2 2 0 0 1-2-2H7a2 2 0 0 1-2 2H3v-5zm3.5-4L5.3 12h13.4l-1.2-3h-11zM6.5 15.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm11 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/></svg>
      </a>
    </div>
  </section>
</aside>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
