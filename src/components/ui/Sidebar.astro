      </a>
      <a href="https://bilibili.com" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="Bilibili">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906L17.813 4.653zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.764-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773H5.333zm2.347 3.013c.356 0 .658.129.907.387.249.258.373.564.373.92v1.173c0 .356-.124.662-.373.92-.249.258-.551.387-.907.387-.355 0-.657-.129-.906-.387-.25-.258-.373-.564-.373-.92V11.56c0-.356.124-.662.373-.92.249-.258.551-.387.906-.387zm8.64 0c.356 0 .658.129.907.387.249.258.373.564.373.92v1.173c0 .356-.124.662-.373.92-.249.258-.551.387-.907.387-.355 0-.657-.129-.906-.387-.25-.258-.373-.564-.373-.92V11.56c0-.356.124-.662.373-.92.249-.258.551-.387.906-.387z"/></svg>
      </a>
      <a href="/rss.xml" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="RSS">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
      </a>
      <a href="mailto:hello@example.com" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="Email">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </a>
      <a href="/drive" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="Voxel Drive" title="Voxel Drive">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M3 13l1.5-4.5A2 2 0 0 1 6.4 7h11.2a2 2 0 0 1 1.9 1.5L21 13v5h-2a2 2 0 0 1-2-2H7a2 2 0 0 1-2 2H3v-5zm3.5-4L5.3 12h13.4l-1.2-3h-11zM6.5 15.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm11 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/></svg>
      </a>
    </div>
  </section>
</aside>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
