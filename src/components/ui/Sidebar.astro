---
import type { CurrentItem, SteamDemoStatus, SteamGame } from '../../lib/types';
import { getCurrentItems, initRuntime } from '../../lib/api';
import { mockCurrentItems } from '../../lib/mock-data';
import { mediaTypeLabels } from '../../lib/media-config';
import { getDemoSteamStatus, getSteamGames } from '../../lib/steam';

interface Props {
  currentItems?: CurrentItem[];
  stats?: { articles?: number; photos?: number; microblogs?: number; media?: number };
  steamGames?: SteamGame[];
}

// Inject Cloudflare runtime env if available
const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) {
  initRuntime(runtimeEnv);
}

// Fetch current items - with fallback to mock data on error
let currentItems: CurrentItem[] = mockCurrentItems;
try {
  const fetched = await getCurrentItems();
  if (fetched.length > 0) {
    currentItems = fetched;
  }
} catch (e) {
  console.error('Failed to fetch current items:', e);
}

currentItems = Astro.props.currentItems || currentItems;
let steamGames: SteamGame[] = Astro.props.steamGames || [];
const isSteamDemo = import.meta.env.DEV;
const steamDemoStatus = getDemoSteamStatus();
if (!Astro.props.steamGames) {
  const steamId = runtimeEnv?.STEAM_ID || import.meta.env.PUBLIC_STEAM_ID;
  try {
    steamGames = await getSteamGames(steamId, runtimeEnv?.STEAM_API_KEY);
  } catch (error) {
    console.error('Failed to fetch Steam games:', error);
  }
}
const orderedSteamGames = isSteamDemo
  ? [...steamGames].sort((game, otherGame) =>
      game.name === steamDemoStatus.currentGameName ? -1 : otherGame.name === steamDemoStatus.currentGameName ? 1 : 0
    )
  : steamGames;
const stats = Astro.props.stats || {};

const typeLabels: Record<string, string> = {
  reading: '阅读中',
  watching: '观看中',
  playing: '游玩中',
  listening: '收听中',
};

function formatDate(date: Date): string {
  return date.getFullYear() === new Date().getFullYear()
    ? date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })
    : date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
}

function formatHours(minutes: number): string {
  return minutes >= 60 ? `${Math.round(minutes / 60)} 小时` : `${minutes} 分钟`;
}

function isCurrentSteamGame(game: SteamGame, status: SteamDemoStatus): boolean {
  return Boolean(status.currentGameName && game.name === status.currentGameName);
}

---

<aside class="space-y-6">
 <!-- Currently -->
 <!-- Currently -->
{currentItems.length > 0 && (
   <section class="border-t border-border pt-5 mt-5">
      <h3 class="text-sm font-medium text-text-secondary uppercase tracking-wider mb-3">
        最近
      </h3>
      <div class="space-y-3">
        {currentItems.map((item) => {
          const mediaType = (item as any).mediaType || (item.type === 'reading' ? 'book' : item.type === 'watching' ? 'movie' : item.type === 'listening' ? 'music' : 'game');
          return (
          <div class="flex items-start gap-3">
            {item.cover ? (
              <img
                src={item.cover}
                alt={item.title}
                class="w-10 h-14 object-cover rounded flex-shrink-0"
                loading="lazy"
              />
            ) : (
              <div class="w-10 h-14 rounded bg-surface-secondary flex items-center justify-center flex-shrink-0">
                <span class="text-xs text-text-muted">
                  {mediaType === 'book' ? '书' : mediaType === 'movie' ? '影' : mediaType === 'tv' ? '剧' : mediaType === 'music' ? '音' : mediaType === 'game' ? '游' : mediaType === 'manga' ? '漫' : mediaType === 'anime' ? '番' : '看'}
                </span>
              </div>
            )}
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="media-badge" data-media={mediaType} style="padding: 0.125rem 0.375rem; font-size: 0.6875rem;">
                  {mediaTypeLabels[mediaType as keyof typeof mediaTypeLabels] || mediaType}
                </span>
                {item.date && (
                  <span class="text-xs text-text-muted">
                    {item.endDate
                      ? `${formatDate(item.date)} → ${formatDate(item.endDate)}`
                      : `已进行 ${Math.floor((Date.now() - (item.date as Date).getTime()) / 86400000)} 天`}
                  </span>
                )}
              </div>
              {item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-text-primary hover:underline transition-colors line-clamp-1"
                >
                  {item.title}
                </a>
              ) : (
                <p class="text-sm text-text-primary line-clamp-1">{item.title}</p>
              )}
              {item.author && (
                <p class="text-xs text-text-muted truncate">{item.author}</p>
              )}
              
            </div>
          </div>
        )})}
      </div>
    </section>
  )}
{steamGames.length > 0 && (
  <section class="border-t border-border pt-5 mt-5">
    <h3 class="text-sm font-medium text-text-secondary uppercase tracking-wider mb-3">
      在玩
    </h3>
    <div class="space-y-3">
      {orderedSteamGames.map((game) => (
        <a
          href={game.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3"
        >
          <img
            src={game.cover}
            alt={game.name}
            class="w-16 h-9 object-cover rounded-sm flex-shrink-0"
            loading="lazy"
          />
          <div class="min-w-0 flex-1">
            <div class="flex min-w-0 items-center gap-2">
              <p class={`text-sm line-clamp-1 group-hover:underline ${isSteamDemo && isCurrentSteamGame(game, steamDemoStatus) ? 'text-[#6cc644]' : 'text-text-primary'}`}>
                {game.name}
              </p>
              {isSteamDemo && isCurrentSteamGame(game, steamDemoStatus) && (
                <span class="flex-shrink-0 text-xs text-[#6cc644]">正在玩</span>
              )}
            </div>
            <p class="text-xs text-text-muted truncate">
              两周 {formatHours(game.playtimeTwoWeeksMinutes)} · 总计 {formatHours(game.playtimeForeverMinutes)}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
 <!-- Stats -->
 <section class="border-t border-border pt-5 mt-5">
   <h3 class="text-sm font-medium text-text-secondary uppercase tracking-wider mb-3">
     统计
    </h3>
    <div class="grid grid-cols-2 gap-4 text-center">
      {stats.articles !== undefined && (
        <div>
          <p class="text-2xl font-ui font-semibold text-text-primary">{stats.articles}</p>
          <p class="text-xs text-text-muted">篇文章</p>
        </div>
      )}
      {stats.photos !== undefined && (
        <div>
          <p class="text-2xl font-ui font-semibold text-text-primary">{stats.photos}</p>
          <p class="text-xs text-text-muted">张照片</p>
        </div>
      )}
      {stats.microblogs !== undefined && (
        <div>
          <p class="text-2xl font-ui font-semibold text-text-primary">{stats.microblogs}</p>
          <p class="text-xs text-text-muted">条动态</p>
        </div>
      )}
      {stats.media !== undefined && (
        <div>
          <p class="text-2xl font-ui font-semibold text-text-primary">{stats.media}</p>
          <p class="text-xs text-text-muted">条标记</p>
        </div>
      )}
    </div>
  </section>

  <!-- Social Links -->
  <section class="border-t border-border pt-5 mt-5">
    <div class="flex items-center gap-4">
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-text-primary transition-colors" aria-label="GitHub">
