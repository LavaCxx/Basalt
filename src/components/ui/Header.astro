---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const baseNavItems = [
  { label: '首页', href: '/' },
  { label: '归档', href: '/archives' },
  { label: '留影', href: '/memories' },
  { label: '友链', href: '/friends' },
  { label: '关于', href: '/about' },
];
const navItems = import.meta.env.DEV
  ? [...baseNavItems, { label: '实验', href: '/lab' }]
  : baseNavItems;

const currentPath = Astro.url.pathname;
---

<header transition:persist class={`site-header sticky top-0 z-50 ${className || ''}`}>
  <div class="header-cluster">
    <a
      href="/"
      data-astro-prefetch="hover"
      class="header-brand flex items-center gap-2 font-ui font-semibold text-text-primary transition-colors"
    >
      <img src="/favicon-32.png?v=avatar" alt="" width="22" height="22" class="rounded-full" />
      LavaC's Stash
    </a>

    <nav class="header-shell" aria-label="主导航">
    <div class="header-bar flex items-center justify-between">
      <!-- Desktop Navigation -->
      <div class="hidden sm:flex items-center gap-1 font-ui">
        {navItems.map((item) => (
          <a
            href={item.href}
            data-astro-prefetch="hover"
            data-nav-link
           class:list={[
          'nav-link px-3 font-medium transition-colors',
           currentPath === item.href
            ? 'text-text-primary font-semibold is-current'
                : 'text-text-secondary hover:text-text-primary',
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="mobile-menu-button sm:hidden min-w-11 min-h-11 inline-flex items-center justify-center p-2 text-text-secondary hover:text-text-primary"
        aria-label="打开导航菜单"
        aria-controls="mobile-menu"
        aria-expanded="false"
        id="mobile-menu-button"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div class="mobile-menu sm:hidden" id="mobile-menu" aria-hidden="true" inert>
    <div class="mobile-menu-inner space-y-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            data-astro-prefetch="hover"
            data-nav-link
           class:list={[
          'flex min-h-11 items-center px-3 py-2 text-sm font-medium transition-colors',
           currentPath === item.href
                ? 'text-text-primary font-semibold is-current'
                : 'text-text-secondary hover:text-text-primary',
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 1rem 0.75rem 0.75rem;
    pointer-events: none;
  }

  .header-cluster {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.625rem;
    width: fit-content;
    max-width: calc(100vw - 1.5rem);
    margin: 0 auto;
  }

  .header-brand,
  .header-shell {
    pointer-events: auto;
    border: 1px solid color-mix(in srgb, var(--color-border) 86%, var(--color-text-muted));
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    box-shadow: 0 5px 16px rgba(20, 20, 20, 0.065), 0 1px 2px rgba(20, 20, 20, 0.05);
    backdrop-filter: blur(12px);
  }

  .header-brand {
    min-height: 2.875rem;
    padding: 0 0.75rem;
    font-size: 0.875rem;
    white-space: nowrap;
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .header-brand img {
    transition: filter 180ms ease;
  }

  .header-shell {
    width: fit-content;
    max-width: 100%;
    padding: 0 0.35rem 0 0.55rem;
    overflow: hidden;
    transition: border-color 180ms ease;
  }

  .header-bar { height: 2.75rem; }
  .nav-link { display: flex; min-height: 2.25rem; align-items: center; font-size: 0.8125rem; }
  .header-shell [data-nav-link] {
    position: relative;
    border-radius: 0.5rem;
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      box-shadow 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header-shell [data-nav-link]:hover {
    background: color-mix(in srgb, var(--color-text-primary) 7%, transparent);
  }

  .header-shell [data-nav-link]:active {
    background: color-mix(in srgb, var(--color-text-primary) 12%, transparent);
    box-shadow: inset 0 2px 4px rgba(20, 20, 20, 0.12);
  }

  .header-shell [data-nav-link]:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 1px;
  }

  .header-shell [data-nav-link].is-current {
    color: var(--color-background);
    background: var(--color-text-primary);
    box-shadow: 0 4px 10px rgba(20, 20, 20, 0.16), 0 1px 2px rgba(20, 20, 20, 0.12);
  }

  @media (hover: hover) and (pointer: fine) {
    .header-brand:hover {
      color: var(--color-text-primary);
      background: color-mix(in srgb, var(--color-background) 94%, var(--color-text-primary) 6%);
    }

    .header-brand:hover img {
      filter: contrast(1.06) saturate(1.08);
    }
  }

  .header-brand:active {
    background: color-mix(in srgb, var(--color-background) 88%, var(--color-text-primary) 12%);
    box-shadow: inset 0 2px 5px rgba(20, 20, 20, 0.1);
  }

  .header-brand:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  :global(html.riso) .header-brand,
  :global(html.riso) .header-shell {
    border-color: var(--riso-border-ink);
    background:
      radial-gradient(rgba(18, 58, 41, 0.045) 1px, transparent 1.1px),
      rgba(242, 248, 233, 0.86);
    background-size: 7px 7px, auto;
    box-shadow: 3px 2px 0 rgba(63, 154, 103, 0.2), -1px 4px 0 rgba(24, 60, 44, 0.09);
  }

  :global(html.riso) .site-header {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  :global(html.riso) .header-shell [data-nav-link] { box-shadow: none; }

  :global(html.riso) .header-shell [data-nav-link]:hover {
    color: var(--riso-ink);
    background: rgba(63, 154, 103, 0.13);
  }

  :global(html.riso) .header-shell [data-nav-link]:active {
    background: rgba(63, 154, 103, 0.2);
    box-shadow: inset 0 2px 4px rgba(24, 60, 44, 0.16);
  }

  :global(html.riso) .header-shell [data-nav-link]:focus-visible { outline-color: var(--riso-accent); }

  :global(html.riso) .header-shell [data-nav-link].is-current {
    color: #f2f8e9;
    background: rgba(23, 133, 91, 0.92);
    text-shadow: none;
    box-shadow: 2px 2px 0 rgba(63, 154, 103, 0.28), -1px 3px 0 rgba(24, 60, 44, 0.12);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html.riso) .header-brand:hover {
      color: var(--riso-ink);
      background:
        radial-gradient(rgba(18, 58, 41, 0.055) 1px, transparent 1.1px),
        rgba(242, 248, 233, 0.94);
      background-size: 7px 7px, auto;
    }

  }

  :global(html.riso) .header-brand:active {
    background:
      radial-gradient(rgba(18, 58, 41, 0.065) 1px, transparent 1.1px),
      rgba(223, 239, 211, 0.94);
    background-size: 7px 7px, auto;
    box-shadow: inset 0 2px 4px rgba(24, 60, 44, 0.14);
  }

  :global(html.riso) .header-brand:focus-visible { outline-color: var(--riso-accent); }

  .mobile-menu-button {
    position: relative;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .mobile-menu-button span {
    position: absolute;
    width: 1.25rem;
    height: 2px;
    background: currentColor;
    border-radius: 999px;
    transform-origin: center;
    transition: opacity 140ms ease, transform 220ms cubic-bezier(0.2, 0.72, 0.2, 1);
  }

  .mobile-menu-button span:first-child { transform: translateY(-0.375rem); }
  .mobile-menu-button span:last-child { transform: translateY(0.375rem); }
  .mobile-menu-button[aria-expanded='true'] span:first-child { transform: rotate(45deg); }
  .mobile-menu-button[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .mobile-menu-button[aria-expanded='true'] span:last-child { transform: rotate(-45deg); }

  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    min-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: grid-template-rows 240ms cubic-bezier(0.2, 0.72, 0.2, 1), opacity 160ms ease;
  }

  .mobile-menu-inner {
    min-height: 0;
    padding-block: 0;
    overflow: hidden;
    border-top: 0 solid transparent;
    border-top-color: transparent;
    transition: padding 240ms cubic-bezier(0.2, 0.72, 0.2, 1), border-color 180ms ease;
  }

  .mobile-menu a {
    opacity: 0;
    transition: color 160ms ease, opacity 160ms ease;
  }

  .mobile-menu.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .mobile-menu.is-open .mobile-menu-inner { padding-block: 0.75rem; border-top-width: 1px; border-top-color: var(--color-border); }
  .mobile-menu.is-open a { opacity: 1; }
  .mobile-menu.is-open a:nth-child(2) { transition-delay: 25ms; }
  .mobile-menu.is-open a:nth-child(3) { transition-delay: 50ms; }
  .mobile-menu.is-open a:nth-child(4) { transition-delay: 75ms; }
  .mobile-menu.is-open a:nth-child(5) { transition-delay: 100ms; }
  .mobile-menu.is-open a:nth-child(6) { transition-delay: 125ms; }

  :global(html.riso) .mobile-menu-button,
  :global(html.riso) .mobile-menu-button:hover,
  :global(html.riso) .mobile-menu-button:active {
    background: transparent;
    box-shadow: none;
    transform: none;
  }

  :global(html.riso) .mobile-menu.is-open .mobile-menu-inner {
    border-top-color: var(--riso-border-ink);
    background-image: radial-gradient(rgba(18, 58, 41, 0.04) 1px, transparent 1.1px);
    background-size: 7px 7px;
  }

  @media (min-width: 640px) {
    .mobile-menu { display: none; }
  }

  @media (max-width: 639px) {
    .site-header { padding-top: 0.875rem; }
    .header-cluster { width: 100%; justify-content: space-between; }
    .header-brand { min-height: 3rem; font-size: 0.875rem; }
    .header-shell { position: relative; min-width: 3.5rem; padding-inline: 0.35rem; overflow: visible; }
    .header-bar { height: 3rem; }

    .mobile-menu {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      z-index: 2;
      width: min(10rem, calc(100vw - 1.5rem));
      pointer-events: none;
      visibility: hidden;
      border: 1px solid transparent;
      border-radius: 0.75rem;
      background: color-mix(in srgb, var(--color-background) 94%, transparent);
      box-shadow: 0 8px 24px rgba(20, 20, 20, 0.1), 0 1px 2px rgba(20, 20, 20, 0.06);
      backdrop-filter: blur(14px);
      transition:
        grid-template-rows 240ms cubic-bezier(0.2, 0.72, 0.2, 1),
        opacity 160ms ease,
        visibility 0s linear 240ms;
    }

    .mobile-menu.is-open {
      pointer-events: auto;
      visibility: visible;
      border-color: var(--color-border);
      transition-delay: 0s;
    }

    .mobile-menu.is-open .mobile-menu-inner { padding: 0.45rem; border-top-width: 0; }

    :global(html.riso) .mobile-menu.is-open {
      border-color: var(--riso-border-ink);
      background:
        radial-gradient(rgba(18, 58, 41, 0.045) 1px, transparent 1.1px),
        rgba(242, 248, 233, 0.92);
      background-size: 7px 7px, auto;
      box-shadow: 3px 2px 0 rgba(63, 154, 103, 0.2), -1px 4px 0 rgba(24, 60, 44, 0.09);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-shell,
    .header-shell [data-nav-link],
    .header-brand,
    .header-brand img,
    .mobile-menu-button span,
    .mobile-menu,
    .mobile-menu-inner,
    .mobile-menu a {
      transition: none;
    }

  }
</style>

<script>
  function initializeMobileMenu() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

    const setOpen = (isOpen: boolean) => {
      menu.classList.toggle('is-open', isOpen);
      menu.toggleAttribute('inert', !isOpen);
      menu.setAttribute('aria-hidden', String(!isOpen));
      button.setAttribute('aria-expanded', String(isOpen));
      button.setAttribute('aria-label', isOpen ? '关闭导航菜单' : '打开导航菜单');
    };

    if (button.dataset.menuInitialized !== 'true') {
      button.dataset.menuInitialized = 'true';
      button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          button.focus();
        }
      });
      window.matchMedia('(min-width: 640px)').addEventListener('change', (event) => {
        if (event.matches) setOpen(false);
      });
    }

    setOpen(false);
  }

  // Update active nav state on page navigation (for View Transitions)
  function updateActiveNav() {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('nav a[data-nav-link]');

    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      const isActive = href === currentPath;

      link.classList.toggle('text-text-primary', isActive);
      link.classList.toggle('text-text-secondary', !isActive);
      link.classList.toggle('font-semibold', isActive);
      link.classList.toggle('is-current', isActive);
    });
  }

  initializeMobileMenu();
  updateActiveNav();

  document.addEventListener('astro:page-load', () => {
    initializeMobileMenu();
    updateActiveNav();
  });
</script>
