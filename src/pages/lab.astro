---
import Layout from '../layouts/Layout.astro';
import OneBitLab from '../components/islands/OneBitLab';
import RisoPortraitLab from '../components/islands/RisoPortraitLab';
import EastwardMenuLab from '../components/islands/EastwardMenuLab';
import RisoMusicPlayer from '../components/islands/RisoMusicPlayer';
---

<Layout title="Lab" description="网页视觉实验：1-bit 抖动与 RISO 插画风格">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-8">
      <h1 class="font-ui text-3xl font-bold text-text-primary mb-2">Lab</h1>
      <p class="text-text-secondary text-sm">
        视觉语言实验。从 1-bit 抖动到 RISO 错版插画，探索 Web 上的可交互图像。
      </p>
    </header>

    <section class="lab-section floating-header-lab" aria-labelledby="floating-header-title">
      <div class="blog-diff-heading">
        <div>
          <p class="blog-diff-kicker">Navigation shell · floating paper bar</p>
          <h2 id="floating-header-title">居中浮动 Header</h2>
        </div>
        <p>不照搬完整胶囊：保留编辑式边框和纸面感，让导航从全宽横线变成独立、居中的页面对象。</p>
      </div>

      <div class="floating-header-grid">
        <article class="floating-header-demo">
          <div class="blog-preview-label"><span>LIGHT</span><small>克制的浮动编辑栏</small></div>
          <div class="floating-header-stage">
            <div class="floating-header-shell">
              <a class="floating-header-brand" href="#floating-header-title" aria-label="返回首页"><span aria-hidden="true">L</span><b>LavaC's Stash</b></a>
              <nav aria-label="Light 浮动导航示例"><a class="is-current" href="#floating-header-title">首页</a><a href="#floating-header-title">归档</a><a href="#floating-header-title">相册</a><a href="#floating-header-title">友链</a><a href="#floating-header-title">关于</a></nav>
              <span class="floating-header-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
            </div>
            <div class="floating-header-content"><small>数字花园 · 内容聚合 · 生活证据</small><h3>你好，我是 LavaC。</h3><p>文章、随手记、照片，以及最近在看在玩的东西。</p><div aria-hidden="true"><i></i><i></i></div></div>
            <footer class="floating-header-footer"><p>© 2026 LavaC</p><p>由 <span>Astro</span> 与 <span>SolidJS</span> 驱动</p></footer>
          </div>
        </article>

        <article class="floating-header-demo floating-header-demo-riso">
          <div class="blog-preview-label"><span>RISO</span><small>纸面与轻微套色</small></div>
          <div class="floating-header-stage">
            <div class="floating-header-shell">
              <a class="floating-header-brand" href="#floating-header-title" aria-label="返回首页"><span aria-hidden="true">L</span><b>LavaC's Stash</b></a>
              <nav aria-label="RISO 浮动导航示例"><a class="is-current" href="#floating-header-title">首页</a><a href="#floating-header-title">归档</a><a href="#floating-header-title">相册</a><a href="#floating-header-title">友链</a><a href="#floating-header-title">关于</a></nav>
              <span class="floating-header-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
            </div>
            <div class="floating-header-content"><small>数字花园 · 内容聚合 · 生活证据</small><h3>你好，我是 LavaC。</h3><p>网点留在纸面边缘，导航文字本身保持清楚稳定。</p><div aria-hidden="true"><i></i><i></i></div></div>
            <footer class="floating-header-footer"><p>© 2026 LavaC</p><p>由 <span>Astro</span> 与 <span>SolidJS</span> 驱动</p></footer>
          </div>
        </article>
      </div>

      <div class="blog-diff-notes"><span><b>宽度</b> 随内容收缩，桌面端不铺满</span><span><b>位置</b> 顶部保留 14px 呼吸区</span><span><b>导航</b> 只保留身份与页面入口，不承载主题切换</span><span><b>Footer</b> 去掉铺满背景与顶边框，只保留居中文字</span></div>
    </section>

    <section class="lab-section blog-diff" aria-labelledby="blog-diff-title">
      <div class="blog-diff-heading">
        <div>
          <p class="blog-diff-kicker">Homepage review · before / after</p>
          <h2 id="blog-diff-title">博客首页优化 Diff</h2>
        </div>
        <p>同一组内容，比较信息层级、阅读节奏、点击反馈与 RISO 纸面表现。</p>
      </div>

      <p class="blog-diff-mode">LIGHT · 原版主题内的首页优化</p>
      <div class="blog-diff-grid">
        <article class="blog-preview blog-preview-before">
          <div class="blog-preview-label"><span>BEFORE</span><small>当前首页方向</small></div>
          <div class="blog-preview-header">
            <span class="blog-mini-logo">L</span>
            <span>LavaC's Stash</span>
            <button aria-label="菜单示意">☰</button>
          </div>
          <div class="blog-preview-body">
            <p class="preview-eyebrow">你好，我是 LavaC。</p>
            <p class="preview-copy">一个 95 后前端工作者；这里收集文章、生活里的随手记、照片，以及最近在看在玩。</p>
            <div class="preview-links"><span>GitHub</span><span>Steam</span><span>RSS</span><span>Email</span></div>
            <div class="preview-rule"></div>
            <p class="preview-eyebrow">最新文章</p>
            <div class="preview-article">
              <div class="preview-thumb"></div>
              <div><small>2026 年 8 月 22 日</small><h3>把生活整理成一座数字花园</h3><p>一些关于写作、收集和持续维护个人网站的记录。</p></div>
            </div>
            <div class="preview-feed-line"><span>近期轨迹</span><span>时间线内容</span></div>
          </div>
        </article>

        <article class="blog-preview blog-preview-after">
          <div class="blog-preview-label"><span>AFTER</span><small>Light 优化版</small></div>
          <div class="blog-preview-header">
            <span class="blog-mini-logo">L</span>
            <span>LavaC's Stash</span>
            <button aria-label="打开菜单示意">☰</button>
          </div>
          <div class="blog-preview-body">
            <p class="preview-eyebrow">数字花园 · 内容聚合 · 生活证据</p>
            <h3 class="preview-hero-title">你好，我是 LavaC。</h3>
            <p class="preview-copy">文章、随手记、照片，以及最近在看在玩的东西，都被收进同一段持续生长的生活记录里。</p>
            <div class="preview-links preview-links-pills"><span>GitHub ↗</span><span>RSS ↗</span><span>Drive ↗</span></div>
            <div class="preview-rule"></div>
            <div class="preview-section-title"><span>01 / FEATURED</span><span>最新文章</span></div>
            <div class="preview-article preview-article-featured">
              <div class="preview-thumb"></div>
              <div><small>2026.08.22 · 约 6 分钟</small><h3>把生活整理成一座数字花园</h3><p>从内容来源到纸面界面，记录一个个人网站如何慢慢长出来。</p><a href="#blog-diff-title">阅读全文<span class="link-arrow-icon" aria-hidden="true">↗</span></a></div>
            </div>
            <div class="preview-section-title preview-section-after"><span>02 / TIMELINE</span><span>近期轨迹</span></div>
            <div class="preview-feed-line"><span class="preview-dot"></span><span>文章、照片与动态按日期聚合</span></div>
          </div>
        </article>
      </div>

      <p class="blog-diff-mode blog-diff-mode-riso">RISO · RISO 主题内的首页优化</p>
      <div class="blog-diff-grid blog-diff-grid-riso">
        <article class="blog-preview blog-preview-riso blog-preview-riso-before">
          <div class="blog-preview-label"><span>BEFORE</span><small>RISO 原版方向</small></div>
          <div class="blog-preview-header"><span class="blog-mini-logo">L</span><span>LavaC's Stash</span><button aria-label="RISO 菜单示意">☰</button></div>
          <div class="blog-preview-body">
            <p class="preview-eyebrow">你好，我是 LavaC。</p>
            <p class="preview-copy">文章、随手记、照片，以及最近在看在玩。内容以简单列表向下展开。</p>
            <div class="preview-links"><span>GitHub</span><span>Steam</span><span>RSS</span><span>Email</span></div>
            <div class="preview-rule"></div>
            <p class="preview-eyebrow">最新文章</p>
            <div class="preview-article"><div class="preview-thumb"></div><div><small>2026 年 8 月 22 日</small><h3>把生活整理成一座数字花园</h3><p>一些关于写作、收集和持续维护个人网站的记录。</p></div></div>
          </div>
        </article>

        <article class="blog-preview blog-preview-riso blog-preview-riso-after">
          <div class="blog-preview-label"><span>AFTER</span><small>RISO 优化版</small></div>
          <div class="blog-preview-header"><span class="blog-mini-logo">L</span><span>LavaC's Stash</span><button aria-label="打开 RISO 菜单示意">☰</button></div>
          <div class="blog-preview-body">
            <p class="preview-eyebrow">01 / FEATURED</p>
            <h3 class="preview-hero-title">你好，我是 LavaC。</h3>
            <p class="preview-copy">保留纸面、网点和错版性格，把绿色油墨集中在首屏主标题、精选文章和操作反馈上。</p>
            <div class="preview-links preview-links-pills"><span>GitHub ↗</span><span>RSS ↗</span><span>Drive ↗</span></div>
            <div class="preview-rule"></div>
            <div class="preview-section-title"><span>FEATURED POST</span><span>最新文章</span></div>
            <div class="preview-article preview-article-featured"><div class="preview-thumb"></div><div><small>2026.08.22 · 约 6 分钟</small><h3>把生活整理成一座数字花园</h3><p>错版阴影强调重点，正文区域降低纹理噪声。</p><a href="#blog-diff-title">阅读全文<span class="link-arrow-icon" aria-hidden="true">↗</span></a></div></div>
            <div class="preview-section-title preview-section-after"><span>TIMELINE</span><span>近期轨迹</span></div>
            <div class="preview-feed-line"><span class="preview-dot"></span><span>文章、照片与动态按日期聚合</span></div>
          </div>
        </article>
      </div>

      <p class="blog-diff-mode">NO IMAGE · 无图文章状态</p>
      <div class="blog-diff-no-image-grid">
        <article class="blog-no-image-card blog-no-image-light">
          <div class="blog-preview-label"><span>LIGHT / BEFORE</span><small>无图原版</small></div>
          <div class="blog-no-image-content">
            <small>2026 年 8 月 19 日</small>
            <h3>没有配图的文章也应该有自己的呼吸感</h3>
            <p>当文章没有封面时，内容不需要被一个空图片框占位。</p>
          </div>
        </article>
        <article class="blog-no-image-card blog-no-image-light blog-no-image-after">
          <div class="blog-preview-label"><span>LIGHT / AFTER</span><small>无图优化版</small></div>
          <div class="blog-no-image-content">
            <div class="preview-section-title"><span>NOTE · 04 MIN</span><span>2026.08.19</span></div>
            <h3>没有配图的文章也应该有自己的呼吸感</h3>
            <p>直接使用完整文字宽度，保留摘要和阅读全文入口；结构与有图文章保持同一套节奏。</p>
            <a href="#blog-diff-title">阅读全文<span class="link-arrow-icon" aria-hidden="true">↗</span></a>
          </div>
        </article>
        <article class="blog-no-image-card blog-no-image-riso">
          <div class="blog-preview-label"><span>RISO / BEFORE</span><small>无图原版</small></div>
          <div class="blog-no-image-content">
            <small>2026 年 8 月 19 日</small>
            <h3>没有配图的文章也应该有自己的呼吸感</h3>
            <p>纸面主题存在，但文章卡片仍然像一条普通的分隔线。</p>
          </div>
        </article>
        <article class="blog-no-image-card blog-no-image-riso blog-no-image-after">
          <div class="blog-preview-label"><span>RISO / AFTER</span><small>无图优化版</small></div>
          <div class="blog-no-image-content">
            <div class="preview-section-title"><span>NOTE · 04 MIN</span><span>2026.08.19</span></div>
            <h3>没有配图的文章也应该有自己的呼吸感</h3>
            <p>用绿色标题错版、纸面卡片和轻量 CTA 保留 RISO 性格，但不制造假的图片占位。</p>
            <a href="#blog-diff-title">阅读全文<span class="link-arrow-icon" aria-hidden="true">↗</span></a>
          </div>
        </article>
      </div>

      <div class="blog-diff-notes" aria-label="优化说明">
        <span><b>层级</b> 首屏主标题与 Featured 卡片更突出</span>
        <span><b>交互</b> 菜单与链接拥有更大的触摸区域</span>
        <span><b>节奏</b> 用编号和时间线区分内容模块</span>
        <span><b>主题</b> RISO 错版只作用于重点元素，正文保持清晰</span>
        <span><b>Hover Demo</b> 悬停优化版文章卡片，观察静态坐标下的油墨响应</span>
      </div>
    </section>

    <section class="lab-section mobile-menu-lab" aria-labelledby="mobile-menu-lab-title">
      <div class="blog-diff-heading">
        <div>
          <p class="blog-diff-kicker">Mobile navigation · motion demo</p>
          <h2 id="mobile-menu-lab-title">移动菜单动效</h2>
        </div>
        <p>点击菜单按钮，比较 Light 与 RISO 中的折叠展开、图标变形和链接淡入。</p>
      </div>

      <div class="mobile-menu-demo-grid">
        <article class="mobile-menu-demo" data-menu-demo>
          <div class="blog-preview-label"><span>LIGHT</span><small>编辑式折叠</small></div>
          <div class="mobile-menu-shell">
            <div class="mobile-menu-bar">
              <span class="mobile-menu-brand"><i aria-hidden="true">L</i>LavaC's Stash</span>
              <button class="mobile-menu-trigger" type="button" aria-label="打开导航菜单" aria-expanded="false">
                <span></span><span></span><span></span>
              </button>
            </div>
            <div class="mobile-menu-reveal">
              <div class="mobile-menu-reveal-inner">
                <nav aria-label="Light 菜单动效示例">
                  <a href="#mobile-menu-lab-title">首页</a><a href="#mobile-menu-lab-title">归档</a><a href="#mobile-menu-lab-title">相册</a><a href="#mobile-menu-lab-title">友链</a><a href="#mobile-menu-lab-title">关于</a>
                </nav>
              </div>
            </div>
          </div>
        </article>

        <article class="mobile-menu-demo mobile-menu-demo-riso" data-menu-demo>
          <div class="blog-preview-label"><span>RISO</span><small>纸面叠印</small></div>
          <div class="mobile-menu-shell">
            <div class="mobile-menu-bar">
              <span class="mobile-menu-brand"><i aria-hidden="true">L</i>LavaC's Stash</span>
              <button class="mobile-menu-trigger" type="button" aria-label="打开导航菜单" aria-expanded="false">
                <span></span><span></span><span></span>
              </button>
            </div>
            <div class="mobile-menu-reveal">
              <div class="mobile-menu-reveal-inner">
                <nav aria-label="RISO 菜单动效示例">
                  <a href="#mobile-menu-lab-title">首页</a><a href="#mobile-menu-lab-title">归档</a><a href="#mobile-menu-lab-title">相册</a><a href="#mobile-menu-lab-title">友链</a><a href="#mobile-menu-lab-title">关于</a>
                </nav>
              </div>
            </div>
          </div>
        </article>
      </div>

      <div class="blog-diff-notes"><span><b>容器</b> 由顶部边界向下展开</span><span><b>图标</b> 原地变为关闭符号</span><span><b>文字</b> 仅淡入，不横向飞入</span><span><b>减弱动态</b> 直接切换最终状态</span></div>
    </section>

    <section class="lab-section article-structure-diff" aria-labelledby="article-structure-title">
      <div class="blog-diff-heading">
        <div>
          <p class="blog-diff-kicker">Article detail · structure diff</p>
          <h2 id="article-structure-title">文章内页结构 Diff</h2>
        </div>
        <p>比较标题区、导语、正文入口、目录与文末导航的阅读层级；封面始终是可选项。</p>
      </div>

      <p class="blog-diff-mode">LIGHT · 有图文章</p>
      <div class="article-structure-grid">
        <article class="article-structure-card article-structure-before">
          <div class="blog-preview-label"><span>BEFORE</span><small>当前结构</small></div>
          <div class="article-structure-page">
            <h3>把生活整理成一座数字花园</h3>
            <p class="article-structure-date">2026 年 8 月 22 日　<span>数字花园</span></p>
            <p class="article-structure-excerpt">从内容来源到纸面界面，记录一个个人网站如何慢慢长出来。</p>
            <div class="article-structure-cover" aria-hidden="true"></div>
            <div class="article-structure-prose"><i></i><i></i><i></i><b></b><i></i><i></i></div>
            <div class="article-structure-comments">WEBMENTIONS / COMMENTS</div>
          </div>
        </article>
        <article class="article-structure-card article-structure-after">
          <div class="blog-preview-label"><span>AFTER</span><small>阅读结构优化</small></div>
          <div class="article-structure-page">
            <div class="article-structure-path"><span>文章 / 2026</span><span>约 6 分钟</span></div>
            <h3>把生活整理成一座数字花园</h3>
            <p class="article-structure-excerpt">从内容来源到纸面界面，记录一个个人网站如何慢慢长出来。</p>
            <div class="article-structure-meta"><time>2026.08.22</time><span class="article-structure-tag">数字花园</span><span class="article-structure-tag">Web</span></div>
            <div class="article-structure-cover" aria-hidden="true"></div>
            <div class="article-structure-entry" aria-hidden="true"></div>
            <div class="article-structure-reading"><div class="article-structure-prose"><i></i><i></i><i></i><b></b><i></i><i></i></div><aside><span>01</span><span>02</span><span>03</span></aside></div>
            <div class="article-structure-footer"><span>← 上一篇</span><span>下一篇 →</span></div>
            <div class="article-structure-comments">WEBMENTIONS / COMMENTS</div>
          </div>
        </article>
      </div>

      <p class="blog-diff-mode">LIGHT · 无图文章</p>
      <div class="article-structure-grid article-structure-no-cover">
        <article class="article-structure-card article-structure-before">
          <div class="blog-preview-label"><span>BEFORE</span><small>移除封面后直接接正文</small></div>
          <div class="article-structure-page"><h3>没有封面的文章，也需要清晰的正文入口</h3><p class="article-structure-date">2026 年 8 月 19 日</p><p class="article-structure-excerpt">短篇记录不需要为了版式完整而制造一张图片。</p><div class="article-structure-prose"><i></i><i></i><i></i><b></b><i></i></div><div class="article-structure-comments">WEBMENTIONS / COMMENTS</div></div>
        </article>
        <article class="article-structure-card article-structure-after">
          <div class="blog-preview-label"><span>AFTER</span><small>同一结构自然收起封面</small></div>
          <div class="article-structure-page"><div class="article-structure-path"><span>文章 / 札记</span><span>约 4 分钟</span></div><h3>没有封面的文章，也需要清晰的正文入口</h3><p class="article-structure-excerpt">短篇记录不需要为了版式完整而制造一张图片。</p><div class="article-structure-meta"><time>2026.08.19</time><span class="article-structure-tag">随记</span></div><div class="article-structure-entry" aria-hidden="true"></div><div class="article-structure-reading"><div class="article-structure-prose"><i></i><i></i><i></i><b></b><i></i></div><aside><span>01</span><span>02</span></aside></div><div class="article-structure-footer"><span>← 上一篇</span><span>下一篇 →</span></div><div class="article-structure-comments">WEBMENTIONS / COMMENTS</div></div>
        </article>
      </div>

      <p class="blog-diff-mode blog-diff-mode-riso">RISO · 有图 / 无图共用结构</p>
      <div class="article-structure-grid article-structure-riso-grid">
        <article class="article-structure-card article-structure-after article-structure-riso">
          <div class="blog-preview-label"><span>WITH COVER</span><small>有图文章</small></div>
