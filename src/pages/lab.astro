  <script>
    function initializeMenuDemos() {
      document.querySelectorAll<HTMLElement>('[data-menu-demo]').forEach((demo) => {
        if (demo.dataset.initialized === 'true') return;
        demo.dataset.initialized = 'true';
        const trigger = demo.querySelector<HTMLButtonElement>('.mobile-menu-trigger');
        if (!trigger) return;

        const setOpen = (isOpen: boolean) => {
          demo.classList.toggle('is-open', isOpen);
          trigger.setAttribute('aria-expanded', String(isOpen));
          trigger.setAttribute('aria-label', isOpen ? '关闭导航菜单' : '打开导航菜单');
        };

        trigger.addEventListener('click', () => setOpen(!demo.classList.contains('is-open')));
        demo.querySelectorAll<HTMLAnchorElement>('.mobile-menu-reveal a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
        demo.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            setOpen(false);
            trigger.focus();
          }
        });
      });
    }

    initializeMenuDemos();
    document.addEventListener('astro:page-load', initializeMenuDemos);
  </script>
