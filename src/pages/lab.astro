---
import Layout from '../layouts/Layout.astro';
import OneBitLab from '../components/islands/OneBitLab';
---

<Layout title="1-bit Lab" description="1-bit 二值化实验">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-8">
      <h1 class="font-ui text-3xl font-bold text-text-primary mb-2">1-bit Lab</h1>
      <p class="text-text-secondary text-sm">
        
        二值化 / Dithering 实验室。在这里探索 1-bit 美术在 Web 上的可能性。
      </p>
    </header>

    <OneBitLab client:load />
  </div>
</Layout>

<style is:global>
/* ===== 1-Bit Lab 实验室专用样式 ===== */
.onebit-lab {
  font-family: var(--font-sans);
}

.lab-tabs {
  display: flex;
  gap: 0;
  border-bottom: 2px solid var(--color-border);
  margin-bottom: 2rem;
}
.lab-tab {
  padding: 0.625rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-text-secondary);
  background: none;
  border: none;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
  transition: all 0.15s ease;
}
.lab-tab:hover {
  color: var(--color-text-primary);
}
.lab-tab.active {
  color: var(--color-text-primary);
  border-bottom-color: var(--color-text-primary);
}

/* ===== 动态背景 ===== */
.bg-canvas-wrap {
  border: 1px solid var(--color-border);
  border-radius: 0.5rem;
  overflow: hidden;
  background: #000;
  aspect-ratio: 3 / 2;
  position: relative;
}
.bg-canvas {
  width: 100%;
  height: 100%;
  display: block;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  cursor: crosshair;
}

/* ===== 图像抖动 ===== */
.upload-area {
  border: 2px dashed var(--color-border);
  border-radius: 0.5rem;
  padding: 3rem 2rem;
  text-align: center;
}
.upload-title {
  font-size: 1rem;
  font-weight: 500;
  color: var(--color-text-primary);
  margin: 0 0 0.5rem 0;
}
.upload-sub {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
  margin: 0 0 1.5rem 0;
}
.upload-btns {
  display: flex;
  gap: 0.5rem;
  justify-content: center;
  flex-wrap: wrap;
}
.lab-primary-btn {
  padding: 0.5rem 1.25rem;
  font-size: 0.8125rem;
  font-weight: 500;
  background: var(--color-text-primary);
  color: var(--color-background);
  border: none;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: opacity 0.15s;
}
.lab-primary-btn:hover { opacity: 0.85; }
.lab-sample-btn {
  padding: 0.5rem 1rem;
  font-size: 0.8125rem;
  font-weight: 500;
  background: none;
  color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.15s;
}
.lab-sample-btn:hover {
  color: var(--color-text-primary);
  border-color: var(--color-text-muted);
}

.img-compare {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-bottom: 2rem;
}
@media (max-width: 640px) {
  .img-compare { grid-template-columns: 1fr; }
}
.img-slot {
  border: 1px solid var(--color-border);
  border-radius: 0.5rem;
  overflow: hidden;
  background: var(--color-background-alt);
  position: relative;
}
.img-label {
  padding: 0.5rem 0.75rem;
  font-size: 0.6875rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
  border-bottom: 1px solid var(--color-border);
}
.dither-canvas {
  width: 100%;
  height: auto;
  display: block;
}
.processing-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.1);
  font-size: 0.8125rem;
  color: var(--color-text-secondary);
}

/* ===== 控制面板 ===== */
.lab-controls {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  padding: 1.5rem;
  background: var(--color-background-alt);
  border: 1px solid var(--color-border);
  border-radius: 0.5rem;
}
.control-group {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.control-label {
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-text-secondary);
  white-space: nowrap;
  min-width: 80px;
}
.control-label .val {
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  margin-left: 0.25rem;
}
.control-group input[type="range"] {
  flex: 1;
  accent-color: var(--color-text-primary);
}
.btn-group {
  display: flex;
  gap: 0.25rem;
  flex-wrap: wrap;
}
.mini-btn {
  padding: 0.3rem 0.7rem;
  font-size: 0.75rem;
  font-weight: 500;
  background: none;
  color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
  border-radius: 0.25rem;
  cursor: pointer;
  transition: all 0.15s;
}
.mini-btn:hover {
  color: var(--color-text-primary);
  border-color: var(--color-text-muted);
}
.mini-btn.active {
  background: var(--color-text-primary);
  color: var(--color-background);
  border-color: var(--color-text-primary);
}
.lab-hint {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  text-align: center;
  margin-top: 1rem;
}
</style>
