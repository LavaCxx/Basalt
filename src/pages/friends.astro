---
import Layout from '../layouts/Layout.astro';
import Comments from '../components/islands/Comments';
import SmartImage from '../components/islands/SmartImage';
import { getFriends, initRuntime } from '../lib/api';

const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) initRuntime(runtimeEnv);
const friends = await getFriends();

const getHostname = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const formatLatestDate = (date?: Date) => date?.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<Layout title="友链" description="朋友们的网站">
  <div class="page-shell">
    <header class="mb-12">
      <h1 class="font-ui text-4xl font-bold text-text-primary mb-2">友链</h1>
      <p class="text-text-secondary">ALONE isn't always ALONE，</p>
    </header>

    {friends.length > 0 ? (
    <div class="friend-grid">
      {friends.map((friend, index) => (
        <article class="friend-card">
          <svg class="friend-card-texture" viewBox="0 0 320 180" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <pattern id={`friend-dots-${index}`} width="5" height="5" patternUnits="userSpaceOnUse">
                <rect width="2" height="2" fill="currentColor" />
                <rect x="3" y="3" width="1" height="1" fill="currentColor" />
              </pattern>
              <filter id={`friend-noise-${index}`} x="-15%" y="-15%" width="130%" height="130%">
                <feTurbulence
                  type="fractalNoise"
                  baseFrequency={`${0.011 + index * 0.002} ${0.019 + index * 0.003}`}
                  numOctaves="3"
                  seed={17 + index * 23}
                  result="noise"
                />
                <feComponentTransfer in="noise" result="threshold">
                  <feFuncR type="discrete" tableValues="0 0 0 0.18 0.42 0.72 1 1" />
                  <feFuncG type="discrete" tableValues="0 0 0 0.18 0.42 0.72 1 1" />
                  <feFuncB type="discrete" tableValues="0 0 0 0.18 0.42 0.72 1 1" />
                </feComponentTransfer>
                <feComposite in="SourceGraphic" in2="threshold" operator="in" />
              </filter>
              <linearGradient id={`friend-fade-${index}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="black" stop-opacity="0" />
                <stop offset="0.38" stop-color="white" stop-opacity="0.18" />
                <stop offset="1" stop-color="white" />
              </linearGradient>
              <mask id={`friend-mask-${index}`}>
                <rect width="320" height="180" fill={`url(#friend-fade-${index})`} />
              </mask>
            </defs>
            <rect
              width="320"
              height="180"
              fill={`url(#friend-dots-${index})`}
              filter={`url(#friend-noise-${index})`}
              mask={`url(#friend-mask-${index})`}
            />
          </svg>
          <div class="friend-card-overline" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <span class="friend-card-bayer" data-variant={index % 3}>
              {Array.from({ length: 16 }, () => <i></i>)}
            </span>
          </div>
          <div class="friend-card-header">
            {friend.iconUrl ? (
              <SmartImage
                src={friend.iconUrl}
                alt=""
                class="rounded-full w-12 h-12 flex-shrink-0 object-cover"
                width={48}
                height={48}
                client:visible
              >
                <span class="friend-avatar-inline-fallback" aria-hidden="true">{friend.title.charAt(0)}</span>
              </SmartImage>
            ) : (
              <div class="friend-avatar-fallback" aria-hidden="true">
                {friend.title.charAt(0)}
              </div>
            )}
            <div class="friend-card-title">
              <h2><a href={friend.url} target="_blank" rel="noopener noreferrer">{friend.title}</a></h2>
              <span>{getHostname(friend.url)}</span>
            </div>
          </div>
          <p class:list={['friend-card-description', { 'friend-card-description--fallback': !friend.description }]}>
            {friend.description || `访问 ${getHostname(friend.url)}`}
          </p>
          {friend.latestPost && (
            <a class="friend-latest" href={friend.latestPost.url} target="_blank" rel="noopener noreferrer">
              <span class="friend-latest-label">
                最近更新
                {friend.latestPost.publishedAt && <time datetime={friend.latestPost.publishedAt.toISOString()}>{formatLatestDate(friend.latestPost.publishedAt)}</time>}
              </span>
              <strong>{friend.latestPost.title}</strong>
            </a>
          )}
          <a class="friend-card-footer" href={friend.url} target="_blank" rel="noopener noreferrer">
            <span>访问网站</span>
            <svg
              class="friend-card-arrow"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        </article>
      ))}
    </div>
    ) : (
      <div class="friend-empty">
        <p>友链还在整理中。</p>
        <span>稍后再来看看吧。</span>
      </div>
    )}

    <div class="mt-12 text-center">
      <p class="text-text-muted mb-4">想要交换友链？欢迎联系！</p>
      <a
        href="mailto:lavac@foxmail.com"
        class="inline-flex items-center gap-2 px-4 py-2 border border-border rounded-md text-text-secondary hover:text-text-primary hover:border-text-muted transition-colors"
      >
        <svg
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
        联系我
      </a>
    </div>

    <Comments client:load mapping="specific" term="friends" />
  </div>
</Layout>

<style>
  .friend-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .friend-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    min-height: 10rem;
    padding: 1rem 1.25rem 1.1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-background) 92%, white);
    color: var(--color-text-primary);
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(20, 20, 20, 0.04);
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .friend-card-texture {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    color: var(--color-text-primary);
    opacity: 0.1;
    transition: opacity 180ms ease;
    pointer-events: none;
  }

  .friend-card > :not(.friend-card-texture) {
    position: relative;
    z-index: 1;
  }

  .friend-card:hover {
    border-color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-background) 84%, var(--color-border));
    box-shadow: 0 8px 24px rgba(20, 20, 20, 0.08);
  }

  .friend-card:hover .friend-card-texture {
    opacity: 0.2;
  }

  .friend-card:active {
    background: color-mix(in srgb, var(--color-background) 78%, var(--color-border));
    box-shadow: 0 1px 2px rgba(20, 20, 20, 0.04);
  }

  .friend-card:focus-within {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 3px;
  }

  .friend-card-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .friend-card-overline {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  .friend-card-bayer {
    display: grid;
    grid-template-columns: repeat(4, 2px);
    gap: 2px;
  }

  .friend-card-bayer i {
    width: 2px;
    height: 2px;
    background: currentColor;
    opacity: 0.2;
  }

  .friend-card-bayer[data-variant='0'] i:nth-child(1),
  .friend-card-bayer[data-variant='0'] i:nth-child(4),
  .friend-card-bayer[data-variant='0'] i:nth-child(6),
  .friend-card-bayer[data-variant='0'] i:nth-child(7),
  .friend-card-bayer[data-variant='0'] i:nth-child(10),
  .friend-card-bayer[data-variant='0'] i:nth-child(13),
  .friend-card-bayer[data-variant='1'] i:nth-child(2),
  .friend-card-bayer[data-variant='1'] i:nth-child(5),
  .friend-card-bayer[data-variant='1'] i:nth-child(8),
  .friend-card-bayer[data-variant='1'] i:nth-child(11),
  .friend-card-bayer[data-variant='1'] i:nth-child(12),
  .friend-card-bayer[data-variant='1'] i:nth-child(15),
  .friend-card-bayer[data-variant='2'] i:nth-child(1),
  .friend-card-bayer[data-variant='2'] i:nth-child(3),
  .friend-card-bayer[data-variant='2'] i:nth-child(6),
  .friend-card-bayer[data-variant='2'] i:nth-child(9),
  .friend-card-bayer[data-variant='2'] i:nth-child(14),
  .friend-card-bayer[data-variant='2'] i:nth-child(16) {
    opacity: 0.9;
  }

  .friend-card :global(.smart-image) {
    flex: 0 0 3rem;
    width: 3rem;
    height: 3rem;
    aspect-ratio: 1;
  }

  .friend-avatar-fallback {
    display: grid;
    flex: 0 0 auto;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 999px;
    background: var(--color-text-primary);
    color: var(--color-background);
    font-weight: 650;
  }

  .friend-avatar-inline-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--color-text-primary);
    color: var(--color-background);
    font-weight: 650;
  }

  .friend-card :global(.smart-image-loaded .friend-avatar-inline-fallback) {
    display: none;
  }

  .friend-card-title {
    min-width: 0;
  }

  .friend-card-title h2 {
    margin: 0;
    overflow: hidden;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-card-title h2 a {
    color: inherit;
    text-decoration: none;
  }

  .friend-card-title h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .friend-card-title span {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .friend-card-description {
    display: -webkit-box;
    min-height: 2.9rem;
    margin: 1rem 0 0;
    overflow: hidden;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .friend-card-description--fallback {
    color: var(--color-text-muted);
  }

  .friend-latest {
    display: block;
    min-width: 0;
    margin-top: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-background-alt) 70%, transparent);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .friend-latest:hover {
    background: color-mix(in srgb, var(--color-background-alt) 92%, transparent);
  }

  .friend-latest-label {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.06em;
  }

  .friend-latest time {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  .friend-latest strong {
    display: block;
    margin-top: 0.3rem;
    overflow: hidden;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75rem;
    padding-top: 0.65rem;
    border-top: 1px dashed var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .friend-card-arrow {
    width: 1rem;
    height: 1rem;
    color: inherit;
    transition: color 180ms ease;
  }

  .friend-card:hover .friend-card-footer {
    color: var(--color-text-primary);
  }

  :global(html.riso) .friend-card {
    border-color: var(--riso-border-ink);
    background: var(--riso-standard-surface);
    box-shadow: var(--riso-offset-shadow);
  }

  :global(html.riso) .friend-card-texture {
    color: #27855b;
    opacity: 0.18;
    mix-blend-mode: multiply;
  }

  :global(html.riso) .friend-card:hover .friend-card-texture {
    opacity: 0.28;
  }

  :global(html.riso) .friend-card-footer {
    border-color: var(--riso-border-ink);
  }

  :global(html.riso) .friend-latest {
    background: rgba(63, 154, 103, 0.12);
  }

  :global(html.riso) .friend-latest:hover {
    background: rgba(63, 154, 103, 0.2);
  }

  .friend-empty {
    padding: 3rem 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .friend-empty p {
    margin: 0;
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .friend-empty span {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.875rem;
  }

  :global(html.riso) .friend-card:hover {
    border-color: #27855b;
    background: var(--riso-expressive-surface);
    box-shadow: var(--riso-offset-shadow);
  }

  :global(html.riso) .friend-card:active {
    background: var(--riso-plate-a);
    box-shadow: var(--riso-offset-shadow);
  }

  @media (max-width: 900px) {
    .friend-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .friend-grid {
      grid-template-columns: 1fr;
    }

    .friend-card {
      min-height: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-card,
    .friend-card-arrow {
      transition: none;
    }
  }
</style>
