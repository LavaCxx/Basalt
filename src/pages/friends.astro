---
import Layout from '../layouts/Layout.astro';
import Comments from '../components/islands/Comments';
import FriendAvatarDither from '../components/islands/FriendAvatarDither';
import { getFriends, initRuntime } from '../lib/api';

const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) initRuntime(runtimeEnv);
const friends = await getFriends();

const getHostname = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const formatLatestDate = (date?: Date) => date?.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});

const BAYER_4 = [
  0, 8, 2, 10,
  12, 4, 14, 6,
  3, 11, 1, 9,
  15, 7, 13, 5,
];

const smoothstep = (start: number, end: number, value: number) => {
  const position = Math.max(0, Math.min(1, (value - start) / (end - start)));
  return position * position * (3 - 2 * position);
};

const friendDitherCache = new Map<number, string>();

const buildFriendDither = (seed: number) => {
  const cached = friendDitherCache.get(seed);
  if (cached) return cached;

  const cell = 5;
  const columns = 192;
  const rows = 108;
  const path: string[] = [];

  for (let row = 0; row < rows; row += 1) {
    const y = (row + 0.5) / rows;

    for (let column = 0; column < columns; column += 1) {
      const x = (column + 0.5) / columns;
      const rightEdge = smoothstep(0.56, 1, x);
      const bottomEdge = smoothstep(0.66, 1, y);
      const corner = smoothstep(0.48, 0.96, (x + y) / 2);
      const broad = Math.sin((x * 4.8 + seed * 0.37) * Math.PI)
        * Math.cos((y * 3.6 - seed * 0.23) * Math.PI);
      const cross = Math.sin((x + y) * 8.2 + seed * 1.7) * 0.28;
      const field = Math.max(0, Math.min(1, (broad + cross + 1.28) / 2.56));
      const envelope = Math.max(rightEdge * 0.74, bottomEdge * 0.56, corner * 0.34);
      const density = Math.max(0, Math.min(0.82, envelope * (0.34 + field * 0.5) - 0.035));
      const threshold = (BAYER_4[(row % 4) * 4 + (column % 4)] + 0.5) / 16;

      if (density <= threshold) continue;

      path.push(`M${column * cell} ${row * cell}h${cell}v${cell}h-${cell}z`);
    }
  }

  const result = path.join('');
  friendDitherCache.set(seed, result);
  return result;
};
---

<Layout title="友链" description="朋友们的网站">
  <div class="page-shell">
    <header class="mb-12">
      <h1 class="font-ui text-4xl font-bold text-text-primary mb-2">友链</h1>
      <p class="text-text-secondary">ALONE isn't always ALONE.</p>
    </header>

    {friends.length > 0 ? (
    <div class="friend-grid">
      {friends.map((friend, index) => (
        <article class="friend-card">
          <svg class="friend-card-texture" viewBox="0 0 960 540" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
            <defs>
              <pattern id={`friend-riso-dots-${index}`} width="5" height="5" patternUnits="userSpaceOnUse">
                <circle cx="2.5" cy="2.5" r="1.15" fill="currentColor" />
              </pattern>
              <path id={`friend-dither-${index}`} d={buildFriendDither(index)} />
            </defs>
            <g class="friend-texture-light">
              <use href={`#friend-dither-${index}`} />
            </g>
            <g class="friend-texture-riso">
              <use href={`#friend-dither-${index}`} fill={`url(#friend-riso-dots-${index})`} />
            </g>
          </svg>
          <div class="friend-card-overline" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="friend-card-header">
            {friend.iconUrl ? (
              <FriendAvatarDither
                friendId={friend.id}
                title={friend.title}
                client:visible
              />
            ) : (
              <div class="friend-avatar-fallback" aria-hidden="true">
                {friend.title.charAt(0)}
              </div>
            )}
            <div class="friend-card-title">
              <h2><a href={friend.url} target="_blank" rel="noopener noreferrer">{friend.title}</a></h2>
              <span>{getHostname(friend.url)}</span>
            </div>
          </div>
          <p class:list={['friend-card-description', { 'friend-card-description--fallback': !friend.description }]}>
            {friend.description || `访问 ${getHostname(friend.url)}`}
          </p>
          {friend.latestPost && (
            <a class="friend-latest" href={friend.latestPost.url} target="_blank" rel="noopener noreferrer">
              <span class="friend-latest-label">
                最近更新
                {friend.latestPost.publishedAt && <time datetime={friend.latestPost.publishedAt.toISOString()}>{formatLatestDate(friend.latestPost.publishedAt)}</time>}
              </span>
              <strong>{friend.latestPost.title}</strong>
            </a>
          )}
          <a class="friend-card-footer" href={friend.url} target="_blank" rel="noopener noreferrer">
            <span>访问网站</span>
            <svg
              class="friend-card-arrow"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        </article>
      ))}
    </div>
    ) : (
      <div class="friend-empty">
        <p>友链还在整理中。</p>
        <span>稍后再来看看吧。</span>
      </div>
    )}

    <Comments client:load mapping="specific" term="friends" />
  </div>
</Layout>

<style>
  .friend-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .friend-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    min-height: 10rem;
    padding: 1rem 1.25rem 1.1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-background) 92%, white);
    color: var(--color-text-primary);
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(20, 20, 20, 0.04);
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .friend-card-texture {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    color: var(--color-text-primary);
    pointer-events: none;
  }

  .friend-texture-light {
    fill: currentColor;
    opacity: 0.03;
  }

  .friend-texture-riso {
    display: none;
  }

  .friend-card > :not(.friend-card-texture) {
    position: relative;
    z-index: 1;
  }

  .friend-card:hover {
    border-color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-background) 84%, var(--color-border));
    box-shadow: 0 8px 24px rgba(20, 20, 20, 0.08);
  }

  .friend-card:active {
    background: color-mix(in srgb, var(--color-background) 78%, var(--color-border));
    box-shadow: 0 1px 2px rgba(20, 20, 20, 0.04);
  }

  .friend-card:focus-within {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 3px;
  }

  .friend-card-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .friend-card-overline {
    display: flex;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  .friend-card :global(.friend-avatar-dither) {
    position: relative;
    display: grid;
    flex: 0 0 3rem;
    width: 3rem;
    height: 3rem;
    aspect-ratio: 1;
    overflow: hidden;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-background-alt);
  }

  .friend-card :global(.friend-avatar-dither canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    image-rendering: pixelated;
    transition: opacity 140ms ease;
  }

  .friend-card :global(.friend-avatar-dither-ready canvas) {
    opacity: 1;
  }

  .friend-card :global(.friend-avatar-dither-fallback) {
    color: var(--color-text-muted);
    font-weight: 650;
  }

  .friend-card :global(.friend-avatar-dither-ready .friend-avatar-dither-fallback) {
    visibility: hidden;
  }

  .friend-avatar-fallback {
    display: grid;
    flex: 0 0 auto;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 999px;
    background: var(--color-text-primary);
    color: var(--color-background);
    font-weight: 650;
  }

  .friend-card-title {
    min-width: 0;
  }

  .friend-card-title h2 {
    margin: 0;
    overflow: hidden;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-card-title h2 a {
    color: inherit;
    text-decoration: none;
  }

  .friend-card-title h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .friend-card-title span {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .friend-card-description {
    display: -webkit-box;
    min-height: 2.9rem;
    margin: 1rem 0 0;
    overflow: hidden;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .friend-card-description--fallback {
    color: var(--color-text-muted);
  }

  .friend-latest {
    display: block;
    min-width: 0;
    margin-top: 0.85rem;
    padding: 0.75rem 0 0.1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .friend-latest-label {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.06em;
  }

  .friend-latest time {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  .friend-latest strong {
    display: block;
    margin-top: 0.35rem;
    overflow: hidden;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: color 180ms ease, text-decoration-color 180ms ease;
  }

  .friend-latest:hover strong {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .friend-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75rem;
    padding-top: 0.65rem;
    border-top: 1px dashed var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .friend-card-arrow {
    width: 1rem;
    height: 1rem;
    color: inherit;
    transition: color 180ms ease;
  }

  .friend-card:hover .friend-card-footer {
    color: var(--color-text-primary);
  }

  :global(html.riso) .friend-card {
    border-color: var(--riso-border-ink);
    background: var(--riso-standard-surface);
    box-shadow: var(--riso-offset-shadow);
  }

  :global(html.riso) .friend-card-texture {
    color: #27855b;
    mix-blend-mode: multiply;
  }

  :global(html.riso) .friend-card :global(.friend-avatar-dither) {
    border-color: var(--riso-border-ink);
    background: rgba(255, 255, 255, 0.38);
  }

  :global(html.riso) .friend-texture-light {
    display: none;
  }

  :global(html.riso) .friend-texture-riso {
    display: inline;
    opacity: 0.1;
  }

  :global(html.riso) .friend-card-footer {
    border-color: var(--riso-border-ink);
  }

  :global(html.riso) .friend-latest {
    border-color: var(--riso-border-ink);
  }

  .friend-empty {
    padding: 3rem 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .friend-empty p {
    margin: 0;
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .friend-empty span {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.875rem;
  }

  :global(html.riso) .friend-card:hover {
    border-color: #27855b;
    background: var(--riso-expressive-surface);
    box-shadow: var(--riso-offset-shadow);
  }

  :global(html.riso) .friend-card:active {
    background: var(--riso-plate-a);
    box-shadow: var(--riso-offset-shadow);
  }

  @media (max-width: 900px) {
    .friend-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .friend-grid {
      grid-template-columns: 1fr;
    }

    .friend-card {
      min-height: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-card,
    .friend-card-arrow,
    .friend-card :global(.friend-avatar-dither canvas) {
      transition: none;
    }
  }
</style>
