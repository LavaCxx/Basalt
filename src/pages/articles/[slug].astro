---
/**
 * Article Detail Page
 * Dynamic route for displaying full article content
 *
 * Design: Book-like readability with high contrast serif typography
 * Reference: Craig Mod, Frank Chimero
 */

import Layout from '../../layouts/Layout.astro';
import { getArticleBySlug, initRuntime } from '../../lib/api';
import ArticleContent from '../../components/islands/ArticleContent';
import TableOfContents from '../../components/islands/TableOfContents';
import Comments from '../../components/islands/Comments';
import Webmentions from '../../components/islands/Webmentions';

// Initialize D1 binding from Cloudflare runtime env
const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) {
  initRuntime(runtimeEnv);
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug as string);

if (!article) {
  return Astro.redirect('/404');
}

const { title, content, date, image, metadata } = article;
const tags = (metadata as any)?.tags || [];
const readingTime = (metadata as any)?.readingTime || 5;
---

<Layout title={title} description={(metadata as any)?.excerpt || title}>
  <div class="article-layout">
    {/* Main content */}
    <article class="article-page">
      {/* Header - Minimal */}
      <header class="article-header">
        <h1 class="article-title">{title}</h1>
        <div class="article-meta">
          <time datetime={date instanceof Date ? date.toISOString() : String(date)}>
            {(date instanceof Date ? date : new Date(date)).toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag: string) => (
                <span class="article-tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      {/* Excerpt - Italic intro */}
      {(metadata as any)?.excerpt && (
        <p class="article-excerpt">{(metadata as any).excerpt}</p>
      )}

      {/* Cover Image */}
      {image && (
        <figure class="article-cover">
          <img src={image} alt={title} loading="eager" />
        </figure>
      )}

      {/* Content */}
      <div class="article-content prose-basalt">
        <ArticleContent content={content} client:load />
      </div>

      {/* Webmentions */}
      <Webmentions target={Astro.url.href} client:visible />

      {/* Comments */}
      <Comments client:load />

      {/* Footer */}
      <footer class="article-footer">
        <a href="/" class="back-link">← 返回首页</a>
      </footer>
    </article>

    {/* Sidebar - Table of Contents */}
    <aside class="article-sidebar">
      <TableOfContents client:load />
    </aside>
  </div>
</Layout>

<style>
  /* Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  @media (min-width: 1280px) {
    .article-layout {
      grid-template-columns: 1fr 220px;
      padding: 4rem 2rem 6rem;
    }
  }

  .article-page {
    max-width: 42rem;
  }

  /* Sidebar */
  .article-sidebar {
    display: none;
  }

  @media (min-width: 1280px) {
    .article-sidebar {
      display: block;
      padding-top: 6rem; /* Align with content */
    }
  }

  /* Header */
  .article-header {
    margin-bottom: 2rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .article-tag {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-background-alt);
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .article-tag:hover {
    background: var(--color-border);
  }

  .article-title {
    font-family: var(--font-sans);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .article-title {
      font-size: 2.875rem;
    }
  }

  .article-excerpt {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  /* Cover */
  .article-cover {
    margin: 0 0 2.5rem;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    border-radius: 0.375rem;
  }

  /* Content - Book-like prose */
  /* Prose styles moved to global.css .prose-basalt */

  /* Footer */
  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-subtle, #e5e5e5);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }
</style>
