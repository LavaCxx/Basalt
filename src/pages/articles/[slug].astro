---
/**
 * Article Detail Page
 * Dynamic route for displaying full article content
 *
 * Design: Book-like readability with high contrast serif typography
 * Reference: Craig Mod, Frank Chimero
 */

import Layout from '../../layouts/Layout.astro';
import { getArticleBySlug, getArticles, initRuntime } from '../../lib/api';
import ArticleEnhancements from '../../components/islands/ArticleEnhancements';
import TableOfContents from '../../components/islands/TableOfContents';
import Comments from '../../components/islands/Comments';
import Webmentions from '../../components/islands/Webmentions';
import SmartImage from '../../components/islands/SmartImage';
import RisoMusicPlayer from '../../components/islands/RisoMusicPlayer';
import { parseMusicEmbeds } from '../../lib/utils/parse-music-embeds';

// Initialize D1 binding from Cloudflare runtime env
const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) {
  initRuntime(runtimeEnv);
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug as string);

if (!article) {
  return Astro.redirect('/404');
}

const { content, date, updatedDate, image, metadata } = article;
const title = article.title || 'Untitled';
const tags = (metadata as any)?.tags || [];
const readingTime = (metadata as any)?.readingTime || 5;
const aiInvolvement = (metadata as any)?.aiInvolvement;
const showAiDisclosure = aiInvolvement && aiInvolvement !== '未使用';
const canonicalUrl = `https://blog.lavac.cc/articles/${slug}`;
const publishedDate = date instanceof Date ? date : new Date(date);
const modifiedDate = updatedDate
  ? (updatedDate instanceof Date ? updatedDate : new Date(updatedDate))
  : undefined;
const formatArticleDate = (value: Date) => value.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const articles = await getArticles();
const currentArticleIndex = articles.findIndex((item) =>
  item.id === article.id || item.url?.split('/').pop() === slug
);
const previousArticle = currentArticleIndex >= 0 ? articles[currentArticleIndex + 1] : undefined;
const nextArticle = currentArticleIndex > 0 ? articles[currentArticleIndex - 1] : undefined;
const contentBlocks = parseMusicEmbeds(content);
---

<Layout title={title} description={(metadata as any)?.excerpt || title} canonical={canonicalUrl}>
  <div class="article-layout page-shell">
    {/* Main content */}
    <article class="article-page page-reading-column h-entry">
      <data class="u-url" value={canonicalUrl}></data>
      <a class="p-author h-card" href="https://blog.lavac.cc" hidden>
        <data class="p-name" value="LavaC"></data>
        <img class="u-photo" src="/avatar.jpg" alt="" />
      </a>
      {/* Header - Editorial reading hierarchy */}
      <header class="article-header">
        <div class="article-path">
          <a href="/">文章 / {publishedDate.getFullYear()}</a>
          <span>约 {readingTime} 分钟</span>
        </div>

        {image && (
          <figure class="article-cover">
            <SmartImage src={image} alt={title} loading="eager" class="article-cover-image" client:load />
          </figure>
        )}

        <h1 class="article-title p-name">{title}</h1>
        {(metadata as any)?.excerpt && (
          <p class="article-excerpt">{(metadata as any).excerpt}</p>
        )}
        <div class="article-meta">
          {modifiedDate ? (
            <details class="article-date-details">
              <summary>
                <span>最后编辑于</span>
                <time class="dt-updated" datetime={modifiedDate.toISOString()}>{formatArticleDate(modifiedDate)}</time>
                <svg class="article-date-chevron" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </summary>
              <div class="article-date-popover">
                首次发布于
                <time class="dt-published" datetime={publishedDate.toISOString()}>{formatArticleDate(publishedDate)}</time>
              </div>
            </details>
          ) : (
            <span class="article-date">
              发布于 <time class="dt-published" datetime={publishedDate.toISOString()}>{formatArticleDate(publishedDate)}</time>
            </span>
          )}
          {tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag: string) => (
                <span class="article-tag" aria-label={`标签：${tag}`}>
                  <span class="article-tag-prefix" aria-hidden="true">#</span>{tag}
                </span>
              ))}
            </div>
          )}
          {showAiDisclosure && (
            <span class="article-ai-disclosure">AI 参与：{aiInvolvement}</span>
          )}
        </div>
      </header>

      <div class="article-entry-rule" aria-hidden="true"></div>

      {/* Content */}
      <div id="article-start" class="article-content prose-basalt e-content">
        <ArticleEnhancements client:only="solid-js" />
        {contentBlocks.map((block) => block.type === 'music' ? (
          <RisoMusicPlayer
            type={block.musicType}
            id={block.id}
            variant="article"
            client:visible
          />
        ) : (
          <div class="article-content-html" set:html={block.html} />
        ))}
      </div>

      {/* Footer */}
      <footer class="article-footer">
        {(previousArticle || nextArticle) && (
          <nav class="article-adjacent" aria-label="相邻文章">
            {previousArticle ? (
              <a href={previousArticle.url || `/articles/${previousArticle.id}`} class="article-adjacent-link article-adjacent-previous">
                <span>← 上一篇</span>
                <strong>{previousArticle.title || '未命名文章'}</strong>
              </a>
            ) : <span></span>}
            {nextArticle && (
              <a href={nextArticle.url || `/articles/${nextArticle.id}`} class="article-adjacent-link article-adjacent-next">
                <span>下一篇 →</span>
                <strong>{nextArticle.title || '未命名文章'}</strong>
              </a>
            )}
          </nav>
        )}
        <a href="/" class="back-link">← 返回首页</a>
      </footer>

      <section class="article-discussion" aria-label="文章讨论">
        <Webmentions target={Astro.url.href} client:visible />
        <Comments client:load />
      </section>
    </article>

    {/* Sidebar - Table of Contents */}
    <aside class="article-sidebar">
      <TableOfContents client:load />
    </aside>
  </div>
</Layout>

<style>
  /* Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 1280px) {
    .article-layout {
      grid-template-columns: minmax(0, 42rem) 13rem;
      justify-content: center;
      gap: 3.5rem;
    }
  }

  /* Sidebar */
  .article-sidebar {
    display: none;
  }

  @media (min-width: 1280px) {
    .article-sidebar {
      display: block;
    }
  }

  /* Header */
  .article-header {
    margin-bottom: 1.75rem;
  }

  .article-path {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .article-path a {
    color: inherit;
    text-decoration: none;
  }

  .article-path a:hover {
    color: var(--color-text-primary);
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-top: 1rem;
  }

  .article-date-details {
    position: relative;
  }

  .article-date-details summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2rem;
    margin: -0.35rem 0 -0.35rem -0.35rem;
    padding: 0.2rem 0.35rem;
    border-radius: 0.3rem;
    cursor: pointer;
    list-style: none;
    transition: color 160ms ease, background-color 160ms ease, transform 120ms ease;
  }

  .article-date-details summary::-webkit-details-marker {
    display: none;
  }

  .article-date-details summary:hover,
  .article-date-details summary:focus-visible {
    color: var(--color-text-primary);
    background: var(--color-background-alt);
  }

  .article-date-details summary:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 0.15rem;
  }

  .article-date-details summary:active {
    transform: translateY(1px);
  }

  .article-date-chevron {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform 160ms ease;
  }

  .article-date-details[open] .article-date-chevron {
    transform: rotate(180deg);
  }

  .article-date-popover {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    z-index: 10;
    width: max-content;
    max-width: min(18rem, calc(100vw - 3rem));
    padding: 0.6rem 0.75rem;
    color: var(--color-text-secondary);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    box-shadow: 0 0.55rem 1.5rem rgba(0, 0, 0, 0.08);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .article-ai-disclosure {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .article-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.12em;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.025em;
    line-height: 1.35;
    white-space: nowrap;
    color: #256b4d;
    background: rgba(39, 133, 91, 0.09);
    padding: 0.18rem 0.55rem 0.2rem 0.48rem;
    border-radius: 999px;
    border: 1px solid rgba(39, 133, 91, 0.22);
    box-shadow: none;
  }

  .article-tag-prefix {
    font-weight: 700;
    opacity: 0.72;
  }

  .article-title {
    font-family: var(--font-sans);
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.16;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin: 0;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.875rem;
    }
  }

  @media (min-width: 1024px) {
    .article-title {
      font-size: 3.25rem;
    }
  }

  .article-excerpt {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
    margin: 1rem 0 0;
  }

  /* Cover */
  .article-cover {
    margin: 0 0 2rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }

  :global(.article-cover-image.smart-image) {
    width: 100%;
    aspect-ratio: 2.15 / 1;
    border-radius: 0;
  }

  @media (max-width: 640px) {
    :global(.article-cover-image.smart-image) {
      aspect-ratio: 16 / 9;
    }
  }

  .article-entry-rule {
    height: 1px;
    margin: 0 0 2.5rem;
    background: var(--color-border);
  }

  /* Content - Book-like prose */
  /* Prose styles moved to global.css .prose-basalt */

  /* Footer */
  .article-footer {
    margin-top: 4rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .article-adjacent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .article-adjacent-link {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    text-decoration: none;
  }

  .article-adjacent-link span {
    color: var(--color-text-muted);
    font-size: 0.6875rem;
  }

  .article-adjacent-link strong {
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .article-adjacent-link:hover strong,
  .article-adjacent-link:focus-visible strong {
    color: var(--color-accent);
  }

  .article-adjacent-link:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid var(--color-text-primary);
    outline-offset: 0.25rem;
  }

  .article-adjacent-next {
    text-align: right;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  @media (max-width: 520px) {
    .article-adjacent {
      grid-template-columns: 1fr;
    }

    .article-adjacent > span:empty {
      display: none;
    }

    .article-adjacent-next {
      text-align: left;
    }
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  .article-discussion {
    margin-top: 2.5rem;
  }

  :global(html.riso) .article-title {
    color: var(--riso-ink);
    text-shadow: var(--riso-title-shadow-h1);
  }

  :global(html.riso) .article-path,
  :global(html.riso) .article-entry-rule,
  :global(html.riso) .article-footer,
  :global(html.riso) .article-adjacent {
    border-color: var(--riso-border-ink);
  }

  :global(html.riso) .article-entry-rule {
    background: var(--riso-border-ink);
  }

  :global(html.riso) .article-tag {
    color: #285f43;
    background: rgba(63, 154, 103, 0.18);
    border-color: rgba(39, 133, 91, 0.38);
    box-shadow: none;
  }

  :global(html.riso) .article-cover {
    border-color: var(--riso-border-ink);
    box-shadow: var(--riso-offset-shadow);
  }

  :global(html.riso) .article-date-details summary:hover,
  :global(html.riso) .article-date-details summary:focus-visible,
  :global(html.riso) .article-date-popover {
    background: var(--riso-standard-surface);
    border-color: var(--riso-border-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-date-details summary,
    .article-date-chevron {
      transition: none;
    }
  }
</style>
