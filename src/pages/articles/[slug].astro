---
/**
 * Article Detail Page
 * Dynamic route for displaying full article content
 *
 * Design: Book-like readability with high contrast serif typography
 * Reference: Craig Mod, Frank Chimero
 */

import Layout from '../../layouts/Layout.astro';
import { getArticleBySlug, getArticles, initRuntime } from '../../lib/api';
import ArticleEnhancements from '../../components/islands/ArticleEnhancements';
import TableOfContents from '../../components/islands/TableOfContents';
import Comments from '../../components/islands/Comments';
import Webmentions from '../../components/islands/Webmentions';
import SmartImage from '../../components/islands/SmartImage';

// Initialize D1 binding from Cloudflare runtime env
const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) {
  initRuntime(runtimeEnv);
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug as string);

if (!article) {
  return Astro.rewrite('/404');
}

const { content, date, image, metadata } = article;
const title = article.title || 'Untitled';
const tags = (metadata as any)?.tags || [];
const readingTime = (metadata as any)?.readingTime || 5;
const canonicalUrl = `https://blog.lavac.cc/articles/${slug}`;
const publishedDate = date instanceof Date ? date : new Date(date);
const articles = await getArticles();
const currentArticleIndex = articles.findIndex((item) =>
  item.id === article.id || item.url?.split('/').pop() === slug
);
const previousArticle = currentArticleIndex >= 0 ? articles[currentArticleIndex + 1] : undefined;
const nextArticle = currentArticleIndex > 0 ? articles[currentArticleIndex - 1] : undefined;
---

<Layout title={title} description={(metadata as any)?.excerpt || title} canonical={canonicalUrl}>
  <div class="article-layout">
    {/* Main content */}
    <article class="article-page h-entry">
      <data class="u-url" value={canonicalUrl}></data>
      <a class="p-author h-card" href="https://blog.lavac.cc" hidden>
        <data class="p-name" value="LavaC"></data>
        <img class="u-photo" src="/avatar.jpg" alt="" />
      </a>
      {/* Header - Editorial reading hierarchy */}
      <header class="article-header">
        <div class="article-path">
          <a href="/">文章 / {publishedDate.getFullYear()}</a>
          <span>约 {readingTime} 分钟</span>
        </div>
        <h1 class="article-title p-name">{title}</h1>
        {(metadata as any)?.excerpt && (
          <p class="article-excerpt">{(metadata as any).excerpt}</p>
        )}
        <div class="article-meta">
          <time class="dt-published" datetime={publishedDate.toISOString()}>
            {publishedDate.toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag: string) => (
                <span class="article-tag">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      {/* Cover Image */}
      {image && (
        <figure class="article-cover">
          <SmartImage src={image} alt={title} loading="eager" class="rounded-md w-full aspect-video" client:load />
        </figure>
      )}

      <div class="article-entry-rule" aria-hidden="true"></div>

      {/* Content */}
      <div class="article-content prose-basalt e-content">
        <ArticleEnhancements client:only="solid-js" />
        <div class="article-content-html" set:html={content} />
      </div>

      {/* Footer */}
      <footer class="article-footer">
        {(previousArticle || nextArticle) && (
          <nav class="article-adjacent" aria-label="相邻文章">
            {previousArticle ? (
              <a href={previousArticle.url || `/articles/${previousArticle.id}`} class="article-adjacent-link article-adjacent-previous">
                <span>← 上一篇</span>
                <strong>{previousArticle.title || '未命名文章'}</strong>
              </a>
            ) : <span></span>}
            {nextArticle && (
              <a href={nextArticle.url || `/articles/${nextArticle.id}`} class="article-adjacent-link article-adjacent-next">
                <span>下一篇 →</span>
                <strong>{nextArticle.title || '未命名文章'}</strong>
              </a>
            )}
          </nav>
        )}
        <a href="/" class="back-link">← 返回首页</a>
      </footer>

      <section class="article-discussion" aria-label="文章讨论">
        <Webmentions target={Astro.url.href} client:visible />
        <Comments client:load />
      </section>
    </article>

    {/* Sidebar - Table of Contents */}
    <aside class="article-sidebar">
      <TableOfContents client:load />
    </aside>
  </div>
</Layout>

<style>
  /* Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  @media (min-width: 1280px) {
    .article-layout {
      grid-template-columns: 1fr 220px;
      padding: 4rem 2rem 6rem;
    }
  }

  .article-page {
    max-width: 42rem;
  }

  /* Sidebar */
  .article-sidebar {
    display: none;
  }

  @media (min-width: 1280px) {
    .article-sidebar {
      display: block;
    }
  }

  /* Header */
  .article-header {
    margin-bottom: 2.25rem;
  }

  .article-path {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .article-path a {
    color: inherit;
    text-decoration: none;
  }

  .article-path a:hover {
    color: var(--color-text-primary);
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: 1.25rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .article-tag {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text-muted);
    background: transparent;
    padding: 0.125rem 0.4rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
    box-shadow: none;
  }

  .article-title {
    font-family: var(--font-sans);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin: 0;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .article-title {
      font-size: 2.875rem;
    }
  }

  .article-excerpt {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 52ch;
    margin: 1rem 0 0;
  }

  /* Cover */
  .article-cover {
    margin: 0 0 2rem;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    border-radius: 0.375rem;
  }

  .article-entry-rule {
    height: 1px;
    margin: 0 0 2.5rem;
    background: var(--color-border);
  }

  /* Content - Book-like prose */
  /* Prose styles moved to global.css .prose-basalt */

  /* Footer */
  .article-footer {
    margin-top: 4rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .article-adjacent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .article-adjacent-link {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    text-decoration: none;
  }

  .article-adjacent-link span {
    color: var(--color-text-muted);
    font-size: 0.6875rem;
  }

  .article-adjacent-link strong {
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .article-adjacent-link:hover strong,
  .article-adjacent-link:focus-visible strong {
    color: var(--color-accent);
  }

  .article-adjacent-link:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid var(--color-text-primary);
    outline-offset: 0.25rem;
  }

  .article-adjacent-next {
    text-align: right;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  @media (max-width: 520px) {
    .article-adjacent {
      grid-template-columns: 1fr;
    }

    .article-adjacent > span:empty {
      display: none;
    }

    .article-adjacent-next {
      text-align: left;
    }
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  .article-discussion {
    margin-top: 2.5rem;
  }

  :global(html.riso) .article-title {
    color: var(--riso-ink);
    text-shadow: var(--riso-title-shadow-h1);
  }

  :global(html.riso) .article-path,
  :global(html.riso) .article-entry-rule,
  :global(html.riso) .article-footer,
  :global(html.riso) .article-adjacent {
    border-color: var(--riso-border-ink);
  }

  :global(html.riso) .article-entry-rule {
    background: var(--riso-border-ink);
  }

  :global(html.riso) .article-tag {
    color: #42604f;
    background: rgba(255, 255, 255, 0.24);
    border-color: rgba(39, 133, 91, 0.28);
    box-shadow: none;
  }
</style>
