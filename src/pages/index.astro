---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/ui/Sidebar.astro';
import FeedList from '../components/islands/FeedList';
import { getFeedPage, getFeedStats, initRuntime } from '../lib/api';
import type { FeedPage, FeedStats } from '../lib/types';

// Initialize D1 binding from Cloudflare runtime env
const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) {
  initRuntime(runtimeEnv);
}

// Fetch feed items server-side (reads from D1)
let feedPage: FeedPage = { items: [], nextCursor: null };
let stats: FeedStats = { articles: 0, photos: 0, microblogs: 0, media: 0 };
try {
  [feedPage, stats] = await Promise.all([
    getFeedPage({ limit: 30 }),
    getFeedStats(),
  ]);
} catch (e) {
  console.error('Failed to fetch feed items:', e);
}

// Serialize dates for client-side hydration
const serializedItems = feedPage.items.map((item) => ({
  ...item,
  date: item.date instanceof Date ? item.date.toISOString() : item.date,
}));
---

<Layout title="首页" description="数字花园与内容聚合站" withSidebar>
  <FeedList client:load items={serializedItems} nextCursor={feedPage.nextCursor} />

  <!-- Sidebar Slot -->
  <Sidebar slot="sidebar" stats={stats} />
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
