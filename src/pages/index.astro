---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/ui/Sidebar.astro';
import FeedList from '../components/islands/FeedList';
import { getFeedItems, initRuntime } from '../lib/api';

// Initialize D1 binding from Cloudflare runtime env
const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) {
  initRuntime(runtimeEnv);
}

// Fetch feed items server-side (reads from D1)
let feedItems: any[] = [];
try {
  feedItems = await getFeedItems();
} catch (e) {
  console.error('Failed to fetch feed items:', e);
}

// Compute stats from feed items already fetched (no extra requests)
const stats: { articles?: number; photos?: number; microblogs?: number; media?: number } = {
  articles: feedItems.filter((i: any) => i.type === 'article').length,
  photos: feedItems.filter((i: any) => i.type === 'photo').length,
  microblogs: feedItems.filter((i: any) => i.type === 'microblog').length,
  media: feedItems.filter((i: any) => i.type === 'media').length,
};

// Serialize dates for client-side hydration
const serializedItems = feedItems.map((item) => ({
  ...item,
  date: item.date instanceof Date ? item.date.toISOString() : item.date,
}));
---

<Layout title="首页" description="数字花园与内容聚合站" withSidebar>
  <FeedList client:load items={serializedItems} />

  <!-- Sidebar Slot -->
  <Sidebar slot="sidebar" stats={stats} />
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
