---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/ui/Sidebar.astro';
import FeedList from '../components/islands/FeedList';
import { getFeedItems, setRuntimeEnvAndClearCache } from '../lib/api';
import { getAllArticles, getAllPhotos } from '../lib/api/notion';

// Inject Cloudflare runtime env if available
const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) {
  setRuntimeEnvAndClearCache(runtimeEnv);
}

// Fetch feed items server-side
let feedItems: any[] = [];
try {
  feedItems = await getFeedItems();
} catch (e) {
  console.error('Failed to fetch feed items:', e);
}

// Compute stats from real data
let stats: { articles?: number; photos?: number; microblogs?: number; media?: number } = {};
try {
  const [articles, photos] = await Promise.all([getAllArticles(), getAllPhotos()]);
  stats = {
    articles: articles.length,
    photos: photos.length,
    microblogs: feedItems.filter((i: any) => i.type === 'microblog').length,
    media: feedItems.filter((i: any) => i.type === 'media').length,
  };
} catch (e) {
  console.error('Failed to compute stats:', e);
}

// Serialize dates for client-side hydration
const serializedItems = feedItems.map((item) => ({
  ...item,
  date: item.date instanceof Date ? item.date.toISOString() : item.date,
}));
---

<Layout title="首页" description="数字花园与内容聚合站" withSidebar>
  <FeedList client:load items={serializedItems} />

  <!-- Sidebar Slot -->
  <Sidebar slot="sidebar" stats={stats} />
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
