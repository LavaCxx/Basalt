---
import VoxelDrive from '../components/islands/VoxelDrive';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
<title>{Astro.props.text ? `${Astro.props.text} · Voxel Drive` : "Voxel Drive"}</title>
    <script is:inline>
      (() => {
        const baseTitle = document.title;
        const width = 18;
        const carIndex = 8;
        const roadside = ["🌲", "🪨", "🚏"];
        let roadsideObjects = [];
        let nextObjectIn = 2;
        let titleTimer;

        const updateTitle = () => {
          roadsideObjects = roadsideObjects
            .map((object) => ({ ...object, position: object.position + 1 }))
            .filter((object) => object.position < width);

          nextObjectIn -= 1;
          if (nextObjectIn <= 0) {
            roadsideObjects.push({
              symbol: roadside[Math.floor(Math.random() * roadside.length)],
              position: 0,
            });
            nextObjectIn = 12 + Math.floor(Math.random() * 6);
          }

          const cells = Array.from({ length: width }, () => "_");
          roadsideObjects.forEach((object) => {
            cells[object.position] = object.symbol;
          });
          cells[carIndex] = "🚗";
          document.title = cells.join("");
        };

        const startTitle = () => {
          if (titleTimer !== undefined) return;
          titleTimer = window.setInterval(updateTitle, 350);
        };

        const stopTitle = () => {
          if (titleTimer === undefined) return;
          window.clearInterval(titleTimer);
          titleTimer = undefined;
          document.title = baseTitle;
        };

        document.addEventListener("visibilitychange", () => {
          document.hidden ? stopTitle() : startTitle();
        });

        startTitle();
      })();
    </script>
  </head>
  <body>
    <VoxelDrive client:only="solid-js" text={Astro.props.text} />
  </body>
</html>

<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    min-height: 100vh;
    background: #05060a;
    font-family: 'Inter', -apple-system, "PingFang SC", sans-serif;
    overflow-x: hidden;
  }

  body {
    min-height: 200vh;
    background: #05060a;
  }

  .voxel-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    display: block;
    pointer-events: none;
  }

  .voxel-vignette {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 65% 50% at 50% 42%, transparent, rgba(5,6,10,0.9) 100%),
      linear-gradient(to bottom, rgba(5,6,10,0.4), transparent 30%, transparent 60%, rgba(5,6,10,0.7));
  }

  /* HUD */
  .voxel-hud {
    position: fixed;
    top: 74px;
    right: 44px;
    z-index: 8;
    font-family: monospace;
    text-align: right;
    pointer-events: none;
  }
  .voxel-hud-row { margin-bottom: 8px; }
  .voxel-hud-val {
    font-size: 18px;
    font-weight: 700;
    color: #6ec6ff;
  }
  .voxel-hud-spd {
    font-size: 30px;
    color: #e89a30;
  }
  .voxel-hud-unit {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(210,214,228,0.7);
  }
  .voxel-hud-label {
    font-size: 10px;
    letter-spacing: 3px;
    color: rgba(210,214,228,0.7);
  }

  /* Toggle render mode button */
  .voxel-toggle-btn {
    position: fixed;
    bottom: 44px;
    right: 44px;
    z-index: 12;
    padding: 12px 20px;
    background: rgba(20,23,34,0.85);
    border: 1px solid rgba(232,154,48,0.5);
    border-radius: 10px;
    color: #e89a30;
    font-family: monospace;
    font-size: 13px;
    letter-spacing: 2px;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.2s;
  }
  .voxel-toggle-btn:hover {
    background: rgba(232,154,48,0.2);
  }

  /* Panel toggle */
  .voxel-panel-toggle {
    position: fixed;
    bottom: 44px;
    left: 44px;
    z-index: 12;
    padding: 8px 16px;
    background: rgba(20,23,34,0.85);
    border: 1px solid rgba(232,154,48,0.4);
    border-radius: 8px;
    color: #e89a30;
    font-family: monospace;
    font-size: 12px;
    letter-spacing: 1px;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  /* Param panel */
  .voxel-panel {
    position: fixed;
    bottom: 92px;
    left: 44px;
    z-index: 12;
    width: 248px;
    padding: 16px 18px;
    background: rgba(15,17,26,0.9);
    border: 1px solid rgba(120,130,150,0.18);
    border-radius: 12px;
    backdrop-filter: blur(12px);
    font-family: monospace;
    font-size: 11px;
    color: #c8ccd6;
    transition: transform 0.25s, opacity 0.25s;
  }
  .voxel-panel.collapsed {
    transform: translateX(-280px);
    opacity: 0;
    pointer-events: none;
  }
  .voxel-panel-title {
    font-size: 10px;
    letter-spacing: 2px;
    color: #e89a30;
    margin-bottom: 12px;
  }
  .voxel-panel-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 9px 0;
  }
  .voxel-panel-label {
    flex: 1;
    color: rgba(210,214,228,0.75);
    font-size: 10.5px;
  }
  .voxel-panel-row input[type="range"] {
    width: 110px;
    accent-color: #e89a30;
    cursor: pointer;
  }
  .voxel-panel-val {
    min-width: 34px;
    text-align: right;
    color: #e89a30;
    font-size: 10px;
  }
  .voxel-panel-shape-group {
    margin: 10px 0;
    padding-top: 10px;
    border-top: 1px solid rgba(120,130,150,0.15);
  }
  .voxel-panel-btns {
    display: flex;
    gap: 4px;
    margin-top: 6px;
    flex-wrap: wrap;
  }
  .voxel-panel-mini-btn {
    padding: 3px 8px;
    font-size: 9.5px;
    font-weight: 500;
    background: none;
    color: rgba(210,214,228,0.6);
    border: 1px solid rgba(120,130,150,0.2);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .voxel-panel-mini-btn:hover {
    color: #c8ccd6;
    border-color: rgba(120,130,150,0.4);
  }
  .voxel-panel-mini-btn.active {
    background: rgba(232,154,48,0.2);
    color: #e89a30;
    border-color: rgba(232,154,48,0.4);
  }
  .voxel-panel-hint {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(120,130,150,0.15);
    font-size: 9.5px;
    color: rgba(160,166,180,0.6);
    line-height: 1.5;
  }

  /* Back link */
  .voxel-back {
    position: fixed;
    top: 44px;
    left: 44px;
    z-index: 12;
    color: rgba(210,214,228,0.5);
    font-family: monospace;
    font-size: 12px;
    letter-spacing: 1px;
    text-decoration: none;
    transition: color 0.2s;
  }
  .voxel-back:hover {
    color: #e89a30;
  }

  @media (max-width: 640px) {
    .voxel-hud { top: 20px; right: 20px; }
    .voxel-toggle-btn { bottom: 20px; right: 20px; padding: 10px 16px; }
    .voxel-panel-toggle { bottom: 20px; left: 20px; }
    .voxel-panel { bottom: 68px; left: 20px; width: calc(100vw - 40px); max-width: 280px; }
    .voxel-back { top: 20px; left: 20px; }
  }
</style>
