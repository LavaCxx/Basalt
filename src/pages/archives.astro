---
import Layout from '../layouts/Layout.astro';
import ArchiveList from '../components/islands/ArchiveList';
import { getArchiveItems, initRuntime } from '../lib/api';

// Initialize D1 binding from Cloudflare runtime env
const runtimeEnv = (Astro as any).runtime?.env || (Astro.locals as any)?.runtime?.env;
if (runtimeEnv) {
  initRuntime(runtimeEnv);
}

let archiveGroups: any[] = [];
try {
  archiveGroups = await getArchiveItems();
} catch (e) {
  console.error('Failed to fetch archives:', e);
}

// Serialize dates for client-side hydration
const serializedGroups = archiveGroups.map((group) => ({
  ...group,
  items: group.items.map((item: any) => ({
    ...item,
    date: item.date instanceof Date ? item.date.toISOString() : item.date,
  })),
}));
---

<Layout title="归档" description="按年份整理的所有文章">
  <ArchiveList client:load groups={serializedGroups} />
</Layout>
