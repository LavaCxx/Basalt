---
import Layout from '../layouts/Layout.astro';
import Comments from '../components/islands/Comments';
---

<Layout title="关于" description="LavaC 的自述">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page Header -->
    <header class="mb-12">
      <h1 class="font-ui text-4xl font-bold text-text-primary mb-2">
        关于
      </h1>
    </header>

  <!-- Content -->
    <div class="prose-basalt">
    <div class="flex items-center gap-4 mb-8">
      <div class="w-20 h-20 rounded-full bg-text-primary text-background flex items-center justify-center font-semibold text-2xl">
        L
      </div>
        <div>
         <h2 class="font-ui text-xl font-semibold text-text-primary m-0">
            LavaC
          </h2>
          <p class="text-text-secondary m-0">
            Front-end Developer
          </p>
        </div>
      </div>

      <h3 class="!mt-8 !mb-4">关于LavaC</h3>
      <p>
        <strong>LavaC</strong>这个怪兮兮的ID来源于2017年入坑
        <a href="https://www.ingress.com" target="_blank" rel="noopener noreferrer">Ingress</a>
        时启用的新代号，即“拉瓦锡”的谐音。
      </p>
      <p>
        95后前端工作者，当然因为长期缺乏与人的技术交流且毕业后也没换过公司，代码写得相当混乱。<br />
        幸亏本身对前端也算得上热爱，倒也不排斥学新技术。
      </p>
      <p>
        性格以当今流行的MBTI<del>赛博占星</del>测试看属于INFP-T。
      </p>

      <h3 class="!mt-8 !mb-4">爱好</h3>
      <ul class="list-disc pl-6 space-y-2 text-text-secondary">
        <li><strong>游戏</strong>：除了PVP的都能接受，csgo有一半时间在荒漠迷城进行3v10bot对战;</li>
        <li>
          <strong>咖啡</strong>：在去年氛围还比较宽松的时候每日的工作始于和同事冲半小时新买的豆子，还写过一篇
          <a
            href="https://www.notion.so/45bd5106003c47f9bd24bb9a607e80c9?v=71242ee64f9b470781222c49b7039df0"
            target="_blank"
            rel="noopener noreferrer"
          >咖啡豆统计</a>。但目前转胶囊和瑞幸也快一年了，问就是懒；
        </li>
        <li><strong>摄影</strong>：今年年初购置了相机后一口气把广州能去的地方走了个遍，现在只有遇到有意思的云时才会掏出来拍两张；</li>
        <li><strong>音乐</strong>：杂食系，但近年来更偏爱City Pop和Synthwave</li>
      </ul>

      <h3 class="!mt-8 !mb-4">关于博客</h3>
      <p>
        有一说一，配色上我更喜欢
        <a href="https://lavace.vercel.app/home" target="_blank" rel="noopener noreferrer">2022版</a>
      </p>

      <div class="flex gap-4 !mt-8">
        <a
         href="mailto:lavac@foxmail.com"
         class="inline-flex items-center gap-2 px-4 py-2 bg-text-primary text-background rounded-md hover:bg-text-secondary transition-colors"
       >
          <svg
            class="w-4 h-4"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          邮件
        </a>
       <a
         href="https://github.com/LavaCxx"
          target="_blank"
         rel="noopener noreferrer"
         class="inline-flex items-center gap-2 px-4 py-2 border border-border rounded-md text-text-secondary hover:text-text-primary hover:border-text-muted transition-colors"
       >
         <svg
            class="w-4 h-4"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <a
         href="https://steamcommunity.com/id/ArcRains/"
          target="_blank"
         rel="noopener noreferrer"
         class="inline-flex items-center gap-2 px-4 py-2 border border-border rounded-md text-text-secondary hover:text-text-primary hover:border-text-muted transition-colors"
       >
         <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><circle cx="10" cy="10" r="2.5" /><path d="M17.5 16.5 13 13" /><circle cx="17" cy="17" r="1.5" /></svg>
          Steam
        </a>
        <a
         href="/rss.xml"
         class="inline-flex items-center gap-2 px-4 py-2 border border-border rounded-md text-text-secondary hover:text-text-primary hover:border-text-muted transition-colors"
       >
         <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
          RSS
        </a>
      </div>
    </div>

    <!-- Comments -->
    <Comments client:load mapping="specific" term="about" />
  </div>
</Layout>
