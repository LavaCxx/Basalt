---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/islands/ThemeToggle';
import OneBitBackground from '../components/islands/OneBitBackground';
import Footer from '../components/ui/Footer.astro';
import Header from '../components/ui/Header.astro';

interface Props {
  title?: string;
  description?: string;
  /** Whether to show the sidebar layout */
  withSidebar?: boolean;
}

const {
  title = 'LavaC',
  description = 'A Digital Garden & Content Aggregator',
  withSidebar = false,
} = Astro.props;

const webmentionUsername = import.meta.env.PUBLIC_WEBMENTION_USERNAME;
const indieauthGithub = import.meta.env.PUBLIC_INDIEAUTH_GITHUB;

const fullTitle = title === 'LavaC' ? title : `${title} | LavaC`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="LavaC" href="/rss.xml" />

    <title>{fullTitle}</title>

    {webmentionUsername && (
      <link rel="webmention" href={`https://webmention.io/${webmentionUsername}/webmention`} />
    )}
    {webmentionUsername && (
      <link rel="pingback" href={`https://webmention.io/${webmentionUsername}/xmlrpc`} />
    )}
    {indieauthGithub && <link rel="me" href={indieauthGithub} />}

    <!-- View Transitions for smooth page navigation -->
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-text-primary font-ui antialiased">
    <!-- Theme Toggle - Client-side only -->
    <ThemeToggle client:only="solid-js" />

    <!-- Header -->
    <Header />

    <!-- Main Content -->
    <main class="min-h-[calc(100vh-8rem)]">
      {withSidebar ? (
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          <div class="flex flex-col lg:flex-row gap-8 lg:items-start">
            <!-- Main content area -->
            <div class="flex-1 min-w-0">
              <slot />
            </div>
            <!-- Sidebar -->
            <aside class="lg:w-72 flex-shrink-0 lg:sticky lg:top-20">
              <slot name="sidebar" />
            </aside>
          </div>
        </div>
      ) : (
        <slot />
      )}
    </main>

    <!-- Footer -->
    <Footer />

    <!-- 1-bit Dynamic Background -->
    <OneBitBackground client:only="solid-js" />
 </body>
</html>
