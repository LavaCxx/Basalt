---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/ui/Footer.astro';
import Header from '../components/ui/Header.astro';
import OneBitBackground from '../components/islands/OneBitBackground';
import OneBitControls from '../components/islands/OneBitControls';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Whether to show the sidebar layout */
  withSidebar?: boolean;
}

const {
  title = "LavaC's Stash",
  description = '文章、动态、照片与阅读记录',
  canonical,
  withSidebar = false,
} = Astro.props;

const webmentionUsername = import.meta.env.PUBLIC_WEBMENTION_USERNAME;
const indieauthGithub = import.meta.env.PUBLIC_INDIEAUTH_GITHUB;

const fullTitle = title === "LavaC's Stash" ? title : `${title} | LavaC's Stash`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png?v=avatar" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=avatar" />
    <link rel="icon" type="image/png" sizes="180x180" href="/favicon-180.png?v=avatar" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=avatar" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=avatar" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=avatar" />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="LavaC's Stash" href="/rss.xml" />

    <title>{fullTitle}</title>

    {webmentionUsername && (
      <link rel="webmention" href={`https://webmention.io/d/${webmentionUsername}/webmention`} />
    )}
    {webmentionUsername && (
      <link rel="pingback" href={`https://webmention.io/${webmentionUsername}/xmlrpc`} />
    )}
    {indieauthGithub && <link rel="me" href={indieauthGithub} />}

    <!-- View Transitions for smooth page navigation -->
    <ClientRouter />
    <script is:inline>
      (() => {
        const theme = localStorage.getItem('theme') === 'riso' ? 'riso' : 'light';
        document.documentElement.classList.toggle('riso', theme === 'riso');
        document.documentElement.classList.remove('dark');
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-text-primary font-ui antialiased">
    <button id="theme-toggle" type="button" transition:persist class="fixed bottom-4 right-4 p-3 rounded-full bg-background border border-border shadow-lg hover:border-text-muted transition-all z-50" aria-label="切换到 RISO 主题" title="切换到 RISO 主题">
      <span class="theme-icon-frame block w-5 h-5 text-text-primary" aria-hidden="true">
        <svg class="theme-icon theme-icon-riso" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <rect class="theme-riso-plate theme-riso-plate-back" x="4.25" y="6.25" width="13.5" height="13.5" rx="2.25" />
          <rect class="theme-riso-plate theme-riso-plate-front" x="6.25" y="4.25" width="13.5" height="13.5" rx="2.25" />
        </svg>
        <svg class="theme-icon theme-icon-light" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4.5" y="4.5" width="15" height="15" rx="2.5" />
        </svg>
      </span>
    </button>

    <!-- Header -->
    <Header />

    <!-- Main Content -->
    <main class="min-h-[calc(100vh-8rem)]">
      {withSidebar ? (
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          <div class="flex flex-col lg:flex-row gap-8 lg:items-start">
            <!-- Main content area -->
            <div class="flex-1 min-w-0">
              <slot />
            </div>
            <!-- Sidebar -->
            <aside class="lg:w-72 flex-shrink-0 lg:sticky lg:top-20">
              <slot name="sidebar" />
            </aside>
          </div>
        </div>
      ) : (
        <slot />
      )}
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Dynamic 1-bit background -->
    <OneBitBackground client:only="solid-js" />
    {import.meta.env.DEV && <OneBitControls client:only="solid-js" />}

    <script is:inline data-astro-rerun>
      (() => {
        const root = document.documentElement;
        const applyTheme = (theme) => {
          root.classList.toggle('riso', theme === 'riso');
          root.classList.remove('dark');
        };
        const getStoredTheme = () =>
          localStorage.getItem('theme') === 'riso' ? 'riso' : 'light';
        const syncThemeToggle = () => {
          const themeToggle = document.getElementById('theme-toggle');
          const isRiso = root.classList.contains('riso');
          const label = isRiso ? '切换到 Light 主题' : '切换到 RISO 主题';
          themeToggle?.setAttribute('aria-label', label);
          themeToggle?.setAttribute('title', label);
          return isRiso;
        };

        if (!window.__basaltThemeReady) {
          window.__basaltThemeReady = true;
          document.addEventListener('click', (event) => {
            if (!(event.target instanceof Element) || !event.target.closest('#theme-toggle')) return;
            const nextTheme = syncThemeToggle() ? 'light' : 'riso';
            applyTheme(nextTheme);
            localStorage.setItem('theme', nextTheme);
            syncThemeToggle();
          });
        }

        applyTheme(getStoredTheme());
        syncThemeToggle();
      })();
    </script>
 </body>
</html>
