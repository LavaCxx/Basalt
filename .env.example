# Notion API Configuration
# Get your API key from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxx

# Database IDs
# Find these in your Notion database URLs
# e.g., https://www.notion.so/username/DATABASE_ID?v=xxx
NOTION_ARTICLES_DATABASE_ID=xxx
NOTION_PHOTOS_DATABASE_ID=xxx

# Optional: Telegram Channel for microblog (public channels only)
# Set the channel username (without @)
# Example: if your channel is t.me/mychannel, set TELEGRAM_CHANNEL_USERNAME=mychannel
TELEGRAM_CHANNEL_USERNAME=your_channel_name

# Optional: Custom RSSHub instance (default: https://rsshub.app)
RSSHUB_INSTANCE=https://rsshub.app

# Optional: Douban/NeoDB RSS feed URL
# Find your RSS URL from your Douban profile page
# Format: https://www.douban.com/feed/people/{YOUR_USER_ID}/
DOUBAN_USER_RSS=https://www.douban.com/feed/people/YOUR_USER_ID/

# Optional: Giscus Comments Configuration
# Get these values from https://giscus.app/zh-CN after configuring your repo
# Your repo must be public and have Discussions enabled
PUBLIC_GISCUS_REPO=your-username/your-repo
PUBLIC_GISCUS_REPO_ID=R_xxxxx
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxx
# Custom theme URL (point to your hosted CSS file)
PUBLIC_GISCUS_THEME_URL=https://raw.githubusercontent.com/your-username/your-repo/main/public/giscus-theme.css
