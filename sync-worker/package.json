{
  "name": "basalt-sync",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --persist-to=../.wrangler/state",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply basalt --remote",
    "migrate-local": "wrangler d1 migrations apply basalt --local --persist-to=../.wrangler/state"
  },
  "dependencies": {
    "@notionhq/client": "^2.3.0",
    "fast-xml-parser": "^5.11.2",
    "shiki": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.151.3"
  },
  "volta": {
    "node": "24.22.1"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
